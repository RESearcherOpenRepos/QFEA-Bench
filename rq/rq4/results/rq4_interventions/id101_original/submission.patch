+# obtain a copy of this license in the LICENSE.txt file in the root directory
+# of this source tree or at http://www.apache.org/licenses/LICENSE-2.0.
+
+"""Semideterministic rounding for QRAO."""
+
+from __future__ import annotations
+
+import numpy as np
+
+from qiskit_optimization.algorithms.optimization_algorithm import (
+    OptimizationResultStatus,
+    SolutionSample,
+)
+from qiskit_optimization.exceptions import QiskitOptimizationError
+
+from .rounding_common import RoundingContext, RoundingResult, RoundingScheme
+
+
+class SemideterministicRounding(RoundingScheme):
+    """Round signs of relaxed single-variable expectation values."""
+
+    def __init__(self, atol: float = 1e-8, seed: int | None = None) -> None:
+        self._atol = atol
+        self._rng = np.random.default_rng(seed)
+
+    def round(self, rounding_context: RoundingContext) -> RoundingResult:
+        """Round a relaxed QRAO solution from expectation values."""
+        expectation_values = rounding_context.expectation_values
+        if expectation_values is None:
+            raise QiskitOptimizationError(
+                "SemideterministicRounding requires per-variable expectation values."
+            )
+        encoding = rounding_context.encoding
+        if len(expectation_values) != encoding.num_vars:
+            raise QiskitOptimizationError(
+                f"Expected {encoding.num_vars} expectation values, got {len(expectation_values)}."
+            )
+        x = np.zeros(encoding.num_vars, dtype=int)
+        for index, value in enumerate(expectation_values):
+            real = float(np.real_if_close(value))
+            if real > self._atol:
+                x[index] = 0
+            elif real < -self._atol:
+                x[index] = 1
+            else:
+                x[index] = int(self._rng.integers(2))
+        status = (
+            OptimizationResultStatus.SUCCESS
+            if encoding.problem.is_feasible(x)
+            else OptimizationResultStatus.INFEASIBLE
+        )
+        sample = SolutionSample(
+            x=x,
+            fval=float(encoding.problem.objective.evaluate(x)),
+            probability=1.0,
+            status=status,
+        )
+        return RoundingResult(expectation_values=list(expectation_values), samples=[sample])
