@@ -0,0 +1,57 @@
+# This code is part of Qiskit.
+#
+# (C) Copyright IBM 2024.
+#
+# This code is licensed under the Apache License, Version 2.0. You may
+# obtain a copy of this license in the LICENSE.txt file in the root directory
+# of this source tree or at http://www.apache.org/licenses/LICENSE-2.0.
+
+"""Verifier for QRAO encoded objective values."""
+
+from __future__ import annotations
+
+from typing import Iterator, Tuple
+
+import numpy as np
+from qiskit.primitives import BaseEstimator
+
+from qiskit_optimization.exceptions import QiskitOptimizationError
+
+from .quantum_random_access_encoding import QuantumRandomAccessEncoding
+
+
+class EncodingCommutationVerifier:
+    """Verify that QRAC encoded expectation values match original objectives."""
+
+    def __init__(self, encoding: QuantumRandomAccessEncoding, estimator: BaseEstimator) -> None:
+        self._encoding = encoding
+        self._estimator = estimator
+
+    def __len__(self) -> int:
+        """Return the number of encoded bit-string assignments covered by the verifier."""
+        return 2**self._encoding.num_vars
+
+    def __iter__(self) -> Iterator[Tuple[str, float, float]]:
+        """Iterate over bit strings with original and encoded objective values."""
+        if self._encoding.num_vars == 0:
+            original = float(self._encoding.problem.objective.evaluate([]))
+            encoded = float(self._encoding.offset * self._encoding.problem.objective.sense.value)
+            yield "", original, encoded
+            return
+        circuits = []
+        bitstrings = []
+        for value in range(len(self)):
+            bits = format(value, f"0{self._encoding.num_vars}b")
+            x = np.fromiter((int(bit) for bit in bits), dtype=int)
+            circuits.append(self._encoding.state_preparation_circuit(x))
+            bitstrings.append(bits)
+        job = self._estimator.run(circuits, [self._encoding.qubit_op] * len(circuits))
+        result = job.result()
+        if len(result.values) != len(circuits):
+            raise QiskitOptimizationError("Estimator returned an unexpected number of values.")
+        sense = self._encoding.problem.objective.sense.value
+        for bits, value in zip(bitstrings, result.values):
+            x = np.fromiter((int(bit) for bit in bits), dtype=int)
+            original = float(self._encoding.problem.objective.evaluate(x))
+            encoded = float(np.real_if_close((value + self._encoding.offset) * sense))
+            yield bits, original, encoded
diff --git a/qiskit_optimization/algorithms/qrao/magic_rounding.py b/qiskit_optimization/algorithms/qrao/magic_rounding.py
