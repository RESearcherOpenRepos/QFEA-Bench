+"""Common classes for QRAO rounding schemes."""
+
+from __future__ import annotations
+
+from abc import ABC, abstractmethod
+from dataclasses import dataclass
+from typing import List, Optional
+
+import numpy as np
+from qiskit import QuantumCircuit
+
+from qiskit_optimization.algorithms.optimization_algorithm import SolutionSample
+
+
+@dataclass
+class RoundingContext:
+    """Context object passed to QRAO rounding schemes."""
+
+    encoding: "QuantumRandomAccessEncoding"
+    expectation_values: Optional[List[complex]]
+    circuit: Optional[QuantumCircuit] = None
+
+
+@dataclass
+class RoundingResult:
+    """Result object returned by QRAO rounding schemes."""
+
+    expectation_values: Optional[List[complex]]
+    samples: List[SolutionSample]
+    bases: Optional[np.ndarray] = None
+    basis_shots: Optional[np.ndarray] = None
+    basis_counts: Optional[List[dict[str, int]]] = None
+
+
+class RoundingScheme(ABC):
+    """Base class for QRAO rounding schemes."""
+
+    @abstractmethod
+    def round(self, rounding_context: RoundingContext) -> RoundingResult:
+        """Round a relaxed QRAO solution."""
+
+
+# imported only for typing to avoid a runtime cycle
+from .quantum_random_access_encoding import QuantumRandomAccessEncoding  # noqa: E402  pylint: disable=wrong-import-position, cyclic-import
