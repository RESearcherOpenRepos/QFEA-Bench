+
+"""Quantum Random Access Optimizer."""
+
+from __future__ import annotations
+
+from typing import List, Optional, Tuple, Union
+
+import numpy as np
+from qiskit import QuantumCircuit
+from qiskit.quantum_info import Statevector
+from qiskit_algorithms import MinimumEigensolver, MinimumEigensolverResult
+
+from qiskit_optimization.algorithms.optimization_algorithm import (
+    OptimizationAlgorithm,
+    OptimizationResult,
+    OptimizationResultStatus,
+    SolutionSample,
+)
+from qiskit_optimization.converters.quadratic_program_to_qubo import QuadraticProgramToQubo
+from qiskit_optimization.exceptions import QiskitOptimizationError
+from qiskit_optimization.problems.quadratic_program import QuadraticProgram, Variable
+
+from .quantum_random_access_encoding import QuantumRandomAccessEncoding
+from .rounding_common import RoundingContext, RoundingResult, RoundingScheme
+from .semideterministic_rounding import SemideterministicRounding
+
+
+class QuantumRandomAccessOptimizationResult(OptimizationResult):
+    """Optimization result returned by the full QRAO solve workflow."""
+
+    def __init__(
+        self,
+        x: Union[List[float], np.ndarray],
+        fval: float,
+        variables: List[Variable],
+        status: OptimizationResultStatus,
+        samples: List[SolutionSample],
+        encoding: QuantumRandomAccessEncoding,
+        relaxed_fval: float,
+        relaxed_result: MinimumEigensolverResult,
+        rounding_result: RoundingResult,
+    ) -> None:
+        super().__init__(x, fval, variables, status, samples=samples, raw_results=relaxed_result)
+        self._encoding = encoding
+        self._relaxed_fval = relaxed_fval
+        self._relaxed_result = relaxed_result
+        self._rounding_result = rounding_result
+
+    @property
+    def encoding(self) -> QuantumRandomAccessEncoding:
+        """QRAO encoding used by the optimizer."""
+        return self._encoding
+
+    @property
+    def relaxed_fval(self) -> float:
+        """Objective value of the relaxed eigensolver result."""
+        return self._relaxed_fval
+
+    @property
+    def relaxed_result(self) -> MinimumEigensolverResult:
+        """Raw relaxed minimum eigensolver result."""
+        return self._relaxed_result
+
+    @property
+    def min_eigen_solver_result(self) -> MinimumEigensolverResult:
+        """Alias for the raw relaxed minimum eigensolver result."""
+        return self._relaxed_result
+
+    @property
+    def rounding_result(self) -> RoundingResult:
+        """QRAO rounding metadata and samples."""
+        return self._rounding_result
+
+
+class QuantumRandomAccessOptimizer(OptimizationAlgorithm):
+    """Run QRAO by encoding, solving the relaxation, and rounding."""
+
+    def __init__(
+        self,
+        min_eigen_solver: MinimumEigensolver,
+        max_vars_per_qubit: int = 3,
+        rounding_scheme: Optional[RoundingScheme] = None,
+        penalty: Optional[float] = None,
+    ) -> None:
+        if not min_eigen_solver.supports_aux_operators():
+            raise QiskitOptimizationError(
+                "QRAO requires a minimum eigensolver that supports auxiliary operators."
+            )
+        self._min_eigen_solver = min_eigen_solver
+        self._max_vars_per_qubit = max_vars_per_qubit
+        self._rounding_scheme = rounding_scheme or SemideterministicRounding()
+        self._converter = QuadraticProgramToQubo(penalty=penalty)
+
+    def get_compatibility_msg(self, problem: QuadraticProgram) -> str:
+        """Return a compatibility message for the given problem."""
+        return QuadraticProgramToQubo.get_compatibility_msg(problem)
+
+    @property
+    def min_eigen_solver(self) -> MinimumEigensolver:
+        """Minimum eigensolver used for the relaxation."""
+        return self._min_eigen_solver
+
+    @property
+    def rounding_scheme(self) -> RoundingScheme:
+        """Rounding scheme used after solving the relaxation."""
+        return self._rounding_scheme
+
+    def solve_relaxed(
+        self, encoding: QuantumRandomAccessEncoding
+    ) -> Tuple[MinimumEigensolverResult, RoundingContext]:
+        """Solve the encoded relaxed Hamiltonian and prepare a rounding context."""
+        aux_ops = [encoding.term_observable(index) for index in range(encoding.num_vars)]
+        relaxed_result = self._min_eigen_solver.compute_minimum_eigenvalue(
+            encoding.qubit_op, aux_operators=aux_ops
+        )
+        expectation_values = self._extract_expectation_values(relaxed_result, encoding.num_vars)
+        if expectation_values is None and encoding.num_vars == 0:
+            expectation_values = []
+        circuit = self._extract_circuit(relaxed_result, encoding.num_qubits)
+        context = RoundingContext(
+            encoding=encoding, expectation_values=expectation_values, circuit=circuit
+        )
+        return relaxed_result, context
+
+    def solve(self, problem: QuadraticProgram) -> QuantumRandomAccessOptimizationResult:
+        """Execute the full QRAO workflow."""
+        self._verify_compatibility(problem)
+        qubo = self._converter.convert(problem)
+        encoding = QuantumRandomAccessEncoding(self._max_vars_per_qubit)
+        encoding.encode(qubo)
+        relaxed_result, rounding_context = self.solve_relaxed(encoding)
+        rounding_result = self._rounding_scheme.round(rounding_context)
+        if not rounding_result.samples:
+            raise QiskitOptimizationError("QRAO rounding produced no solution samples.")
+        # Interpret QUBO samples back to the original problem and aggregate probabilities.
+        raw_samples = rounding_result.samples
+        samples, _ = self._interpret_samples(problem, raw_samples, [self._converter])
+        best = samples[0]
+        relaxed_fval = self._relaxed_fval(relaxed_result, encoding)
+        return QuantumRandomAccessOptimizationResult(
+            x=best.x,
+            fval=best.fval,
+            variables=problem.variables,
+            status=best.status,
+            samples=samples,
+            encoding=encoding,
+            relaxed_fval=relaxed_fval,
+            relaxed_result=relaxed_result,
+            rounding_result=rounding_result,
+        )
+
+    @staticmethod
+    def _extract_expectation_values(
+        result: MinimumEigensolverResult, num_vars: int
+    ) -> Optional[List[complex]]:
+        aux_values = getattr(result, "aux_operators_evaluated", None)
+        if aux_values is None:
+            return None
+        values = []
+        if isinstance(aux_values, dict):
+            iterable = [aux_values[index] for index in range(num_vars)]
+        else:
+            iterable = aux_values[:num_vars]
+        for item in iterable:
+            if item is None:
+                values.append(0.0)
+            elif isinstance(item, tuple):
+                values.append(item[0])
+            else:
+                values.append(item)
+        return values
+
+    @staticmethod
+    def _extract_circuit(result: MinimumEigensolverResult, num_qubits: int) -> Optional[QuantumCircuit]:
+        eigenstate = getattr(result, "eigenstate", None)
+        if isinstance(eigenstate, QuantumCircuit):
+            return eigenstate
+        if isinstance(eigenstate, Statevector):
+            logical_qubits = max(1, num_qubits)
+            circuit = QuantumCircuit(logical_qubits)
+            circuit.initialize(eigenstate.data, range(logical_qubits))
+            return circuit
+        return None
+
+    @staticmethod
+    def _relaxed_fval(result: MinimumEigensolverResult, encoding: QuantumRandomAccessEncoding) -> float:
+        eigenvalue = getattr(result, "eigenvalue", 0.0)
+        return float(np.real_if_close((eigenvalue + encoding.offset) * encoding.problem.objective.sense.value))
