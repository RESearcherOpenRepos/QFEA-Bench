index 0000000..0d62d45
--- /dev/null
+++ b/qiskit_optimization/algorithms/qrao/magic_rounding.py
@@ -0,0 +1,138 @@
+# This code is part of Qiskit.
+#
+# (C) Copyright IBM 2024.
+#
+# This code is licensed under the Apache License, Version 2.0. You may
+# obtain a copy of this license in the LICENSE.txt file in the root directory
+# of this source tree or at http://www.apache.org/licenses/LICENSE-2.0.
+
+"""Magic-basis rounding for QRAO."""
+
+from __future__ import annotations
+
+from collections import defaultdict
+from typing import Dict, List
+
+import numpy as np
+from qiskit import ClassicalRegister, QuantumCircuit
+from qiskit.primitives import BaseSampler
+
+from qiskit_optimization.algorithms.optimization_algorithm import (
+    OptimizationResultStatus,
+    SolutionSample,
+)
+from qiskit_optimization.exceptions import QiskitOptimizationError
+
+from .rounding_common import RoundingContext, RoundingResult, RoundingScheme
+
+
+class MagicRounding(RoundingScheme):
+    """Sample QRAC measurement bases and round outcomes to classical samples."""
+
+    def __init__(
+        self, sampler: BaseSampler, basis_sampling: str = "uniform", seed: int | None = None
+    ) -> None:
+        if basis_sampling not in ("uniform", "weighted"):
+            raise QiskitOptimizationError("basis_sampling must be either 'uniform' or 'weighted'.")
+        self._sampler = sampler
+        self._basis_sampling = basis_sampling
+        self._rng = np.random.default_rng(seed)
+
+    def round(self, rounding_context: RoundingContext) -> RoundingResult:
+        """Round a relaxed QRAO solution by sampling QRAC measurement bases."""
+        if rounding_context.circuit is None:
+            raise QiskitOptimizationError("MagicRounding requires a relaxed-state circuit.")
+        encoding = rounding_context.encoding
+        if encoding.num_qubits == 0:
+            x = np.zeros(encoding.num_vars, dtype=int)
+            return RoundingResult(
+                expectation_values=rounding_context.expectation_values,
+                samples=[self._make_sample(encoding, x, 1.0)],
+            )
+        bases = self._sample_bases(encoding)
+        circuits = self._make_circuits(
+            rounding_context.circuit, bases, encoding.max_vars_per_qubit
+        )
+        sampler_result = self._sampler.run(circuits).result()
+        probabilities: Dict[tuple[int, ...], float] = defaultdict(float)
+        basis_counts: List[dict[str, int]] = []
+        for basis_index, quasi in enumerate(sampler_result.quasi_dists):
+            counts: dict[str, int] = {}
+            for outcome, probability in quasi.items():
+                bitstring = format(int(outcome), f"0{encoding.num_qubits}b")
+                counts[bitstring] = int(round(float(probability)))
+                x = self._decode_outcome(encoding, bases[basis_index], bitstring)
+                probabilities[tuple(x)] += float(probability) / len(bases)
+            basis_counts.append(counts)
+        samples = [
+            self._make_sample(encoding, np.asarray(x, dtype=int), probability)
+            for x, probability in probabilities.items()
+        ]
+        samples.sort(key=lambda sample: (sample.status.value, encoding.problem.objective.sense.value * sample.fval))
+        return RoundingResult(
+            expectation_values=rounding_context.expectation_values,
+            samples=samples,
+            bases=bases,
+            basis_shots=np.ones(len(bases), dtype=int),
+            basis_counts=basis_counts,
+        )
+
+    def _make_circuits(
+        self, circuit: QuantumCircuit, bases: np.ndarray, vars_per_qubit: int
+    ) -> List[QuantumCircuit]:
+        """Build QRAC measurement circuits for sampled bases."""
+        if vars_per_qubit not in (1, 2, 3):
+            raise QiskitOptimizationError("vars_per_qubit must be one of 1, 2, or 3.")
+        circuits = []
+        for basis in bases:
+            qc = circuit.copy()
+            if qc.num_clbits < qc.num_qubits:
+                qc.add_register(ClassicalRegister(qc.num_qubits - qc.num_clbits))
+            for qubit, pauli_index in enumerate(basis):
+                if pauli_index < 0 or pauli_index >= vars_per_qubit:
+                    raise QiskitOptimizationError("Invalid QRAC measurement basis index.")
+                pauli = ("X", "Y", "Z")[int(pauli_index)]
+                if pauli == "X":
+                    qc.h(qubit)
+                elif pauli == "Y":
+                    qc.sdg(qubit)
+                    qc.h(qubit)
+                qc.measure(qubit, qubit)
+            circuits.append(qc)
+        return circuits
+
+    def _sample_bases(self, encoding) -> np.ndarray:
+        bases = np.zeros((1, encoding.num_qubits), dtype=int)
+        for qubit, variables in enumerate(encoding.qubit2vars):
+            if self._basis_sampling == "uniform":
+                bases[0, qubit] = int(self._rng.integers(len(variables)))
+            else:
+                bases[0, qubit] = 0
+        return bases
+
+    @staticmethod
+    def _decode_outcome(encoding, basis: np.ndarray, bitstring: str) -> np.ndarray:
+        x = np.zeros(encoding.num_vars, dtype=int)
+        # bitstring is displayed most-significant first, matching reversed labels.
+        for qubit, variables in enumerate(encoding.qubit2vars):
+            measured_var = variables[int(basis[qubit])]
+            bit = int(bitstring[::-1][qubit])
+            x[measured_var] = bit
+            for var in variables:
+                if var != measured_var:
+                    x[var] = bit
+        return x
+
+    @staticmethod
+    def _make_sample(encoding, x: np.ndarray, probability: float) -> SolutionSample:
+        status = (
+            OptimizationResultStatus.SUCCESS
+            if encoding.problem.is_feasible(x)
+            else OptimizationResultStatus.INFEASIBLE
+        )
+        return SolutionSample(
+            x=x,
+            fval=float(encoding.problem.objective.evaluate(x)),
+            probability=float(probability),
+            status=status,
+        )
