new file mode 100644
index 0000000..ead47e2
--- /dev/null
+++ b/qiskit_optimization/algorithms/qrao/quantum_random_access_encoding.py
@@ -0,0 +1,240 @@
+# This code is part of Qiskit.
+#
+# (C) Copyright IBM 2024.
+#
+# This code is licensed under the Apache License, Version 2.0. You may
+# obtain a copy of this license in the LICENSE.txt file in the root directory
+# of this source tree or at http://www.apache.org/licenses/LICENSE-2.0.
+
+"""Quantum random access encoding for binary quadratic programs."""
+
+from __future__ import annotations
+
+from collections import defaultdict
+from typing import Dict, List, Sequence, Tuple
+
+import numpy as np
+from qiskit import QuantumCircuit
+from qiskit.quantum_info import Pauli, SparsePauliOp
+
+from qiskit_optimization.exceptions import QiskitOptimizationError
+from qiskit_optimization.problems.quadratic_objective import ObjSense
+from qiskit_optimization.problems.quadratic_program import QuadraticProgram
+
+
+class QuantumRandomAccessEncoding:
+    """Encode a binary quadratic program as a QRAC-backed relaxation.
+
+    The encoding maps each binary variable :math:`x_i` to an observable
+    :math:`(1 - \sqrt{m_q} P_i) / 2`, where ``P_i`` is one of ``X``, ``Y`` or
+    ``Z`` on qubit ``q`` and ``m_q`` is the number of variables packed into that
+    qubit.  Quadratically interacting variables are never packed into the same
+    qubit, so products are represented by tensor products of single-qubit Pauli
+    observables.
+    """
+
+    _PAULIS = ("X", "Y", "Z")
+
+    def __init__(self, max_vars_per_qubit: int = 3) -> None:
+        """Args:
+            max_vars_per_qubit: maximum number of variables packed into a qubit (1, 2, or 3).
+        """
+        if max_vars_per_qubit not in (1, 2, 3):
+            raise QiskitOptimizationError(
+                "max_vars_per_qubit must be one of 1, 2, or 3 for QRAC encodings."
+            )
+        self._max_vars_per_qubit = max_vars_per_qubit
+        self._problem: QuadraticProgram | None = None
+        self._qubit_op: SparsePauliOp | None = None
+        self._offset = 0.0
+        self._var2op: Dict[int, Tuple[int, str]] = {}
+        self._qubit2vars: List[List[int]] = []
+
+    @property
+    def max_vars_per_qubit(self) -> int:
+        """The requested maximum number of variables per qubit."""
+        return self._max_vars_per_qubit
+
+    @property
+    def problem(self) -> QuadraticProgram:
+        """The encoded quadratic program."""
+        if self._problem is None:
+            raise QiskitOptimizationError("No problem has been encoded yet.")
+        return self._problem
+
+    @property
+    def encoded_problem(self) -> QuadraticProgram:
+        """Alias for the encoded quadratic program."""
+        return self.problem
+
+    @property
+    def qubit_op(self) -> SparsePauliOp:
+        """SparsePauliOp for the relaxed Hamiltonian."""
+        if self._qubit_op is None:
+            raise QiskitOptimizationError("No problem has been encoded yet.")
+        return self._qubit_op
+
+    @property
+    def offset(self) -> float:
+        """Constant offset of the relaxed Hamiltonian."""
+        return self._offset
+
+    @property
+    def num_vars(self) -> int:
+        """Number of encoded binary variables."""
+        return 0 if self._problem is None else self._problem.get_num_vars()
+
+    @property
+    def num_qubits(self) -> int:
+        """Number of qubits used by the encoding."""
+        return len(self._qubit2vars)
+
+    @property
+    def variable_mapping(self) -> Dict[int, Tuple[int, str]]:
+        """Mapping from variable index to ``(qubit, pauli)``."""
+        return dict(self._var2op)
+
+    @property
+    def var2op(self) -> Dict[int, Tuple[int, str]]:
+        """Alias for :attr:`variable_mapping`."""
+        return self.variable_mapping
+
+    @property
+    def qubit2vars(self) -> List[List[int]]:
+        """Variables assigned to each qubit."""
+        return [vars_.copy() for vars_ in self._qubit2vars]
+
+    @property
+    def compression_ratio(self) -> float:
+        """Ratio of original variables to encoded qubits."""
+        return 1.0 if self.num_qubits == 0 else self.num_vars / self.num_qubits
+
+    @property
+    def minimum_recovery_probability(self) -> float:
+        """Minimum QRAC single-bit recovery probability for the used packing."""
+        if not self._qubit2vars:
+            return 1.0
+        max_used = max(len(v) for v in self._qubit2vars)
+        return 0.5 * (1.0 + 1.0 / np.sqrt(max_used))
+
+    def encode(self, problem: QuadraticProgram) -> None:
+        """Build the qubit operator, offset, and variable-to-Pauli mapping."""
+        self._validate_problem(problem)
+        self._problem = problem
+        self._offset = problem.objective.constant * problem.objective.sense.value
+        self._var2op = {}
+        self._qubit2vars = self._assign_variables(problem)
+        for qubit, variables in enumerate(self._qubit2vars):
+            for slot, var in enumerate(variables):
+                self._var2op[var] = (qubit, self._PAULIS[slot])
+
+        terms: List[Tuple[str, complex]] = []
+        sense = problem.objective.sense.value
+        for idx, coef in problem.objective.linear.to_dict().items():
+            weight = coef * sense / 2
+            self._offset += weight
+            self._append_term(terms, [idx], -weight)
+
+        for (i, j), coef in problem.objective.quadratic.to_dict().items():
+            weight = coef * sense / 4
+            if i == j:
+                self._offset += weight
+            else:
+                self._append_term(terms, [i, j], weight)
+            self._append_term(terms, [i], -weight)
+            self._append_term(terms, [j], -weight)
+            self._offset += weight
+
+        if terms:
+            self._qubit_op = SparsePauliOp.from_list(terms).simplify(atol=0)
+        else:
+            self._qubit_op = SparsePauliOp.from_list([("I" * max(1, self.num_qubits), 0.0)])
+
+    def state_preparation_circuit(self, x: Sequence[int]) -> QuantumCircuit:
+        """Build the QRAC state preparation circuit for a classical bit string."""
+        if len(x) != self.num_vars:
+            raise QiskitOptimizationError(
+                f"Input bit string has length {len(x)} but the encoding has {self.num_vars} variables."
+            )
+        qc = QuantumCircuit(self.num_qubits)
+        for qubit, variables in enumerate(self._qubit2vars):
+            signs = []
+            for var in variables:
+                value = int(x[var])
+                if value not in (0, 1):
+                    raise QiskitOptimizationError("QRAC state preparation requires a binary bit string.")
+                signs.append(1.0 if value == 0 else -1.0)
+            while len(signs) < 3:
+                signs.append(0.0)
+            vec = np.asarray(signs[:3], dtype=float)
+            norm = np.linalg.norm(vec)
+            if norm == 0:
+                continue
+            vec /= norm
+            theta = float(np.arccos(np.clip(vec[2], -1.0, 1.0)))
+            phi = float(np.arctan2(vec[1], vec[0]))
+            qc.ry(theta, qubit)
+            qc.rz(phi, qubit)
+        return qc
+
+    def term_observable(self, variable: int) -> SparsePauliOp:
+        """Return the scaled observable whose expectation is ``1 - 2*x[variable]``."""
+        return SparsePauliOp.from_list([(self._pauli_string([variable]), self._scale([variable]))])
+
+    def _append_term(self, terms: List[Tuple[str, complex]], variables: List[int], coeff: float) -> None:
+        if abs(coeff) == 0:
+            return
+        terms.append((self._pauli_string(variables), coeff * self._scale(variables)))
+
+    def _pauli_string(self, variables: List[int]) -> str:
+        labels = ["I"] * self.num_qubits
+        for var in variables:
+            qubit, pauli = self._var2op[var]
+            if labels[qubit] != "I" and labels[qubit] != pauli:
+                raise QiskitOptimizationError(
+                    "Interacting variables cannot be assigned to non-commuting operators "
+                    "on the same qubit."
+                )
+            labels[qubit] = pauli
+        return "".join(reversed(labels))
+
+    def _scale(self, variables: List[int]) -> float:
+        scale = 1.0
+        for var in variables:
+            qubit, _ = self._var2op[var]
+            scale *= np.sqrt(len(self._qubit2vars[qubit]))
+        return float(scale)
+
+    def _assign_variables(self, problem: QuadraticProgram) -> List[List[int]]:
+        conflicts: Dict[int, set[int]] = defaultdict(set)
+        for (i, j), coeff in problem.objective.quadratic.to_dict().items():
+            if i != j and abs(coeff) > 0:
+                conflicts[i].add(j)
+                conflicts[j].add(i)
+        order = sorted(range(problem.get_num_vars()), key=lambda v: (-len(conflicts[v]), v))
+        bins: List[List[int]] = []
+        for var in order:
+            placed = False
+            for variables in bins:
+                if len(variables) < self._max_vars_per_qubit and all(
+                    other not in conflicts[var] for other in variables
+                ):
+                    variables.append(var)
+                    placed = True
+                    break
+            if not placed:
+                bins.append([var])
+        # Keep Pauli assignment stable inside each qubit.
+        return [sorted(variables) for variables in bins]
+
+    @staticmethod
+    def _validate_problem(problem: QuadraticProgram) -> None:
+        if problem.get_num_vars() > problem.get_num_binary_vars():
+            raise QiskitOptimizationError("QRAO supports only binary variables.")
+        if problem.linear_constraints or problem.quadratic_constraints:
+            raise QiskitOptimizationError(
+                "QRAO supports unconstrained binary quadratic programs. Use a QUBO converter "
+                "to move constraints into the objective."
+            )
+        if problem.objective.sense not in (ObjSense.MINIMIZE, ObjSense.MAXIMIZE):
+            raise QiskitOptimizationError("Unsupported objective sense for QRAO.")
