@@ -0,0 +1,45 @@
+import numpy as np
+from .qnn_loss_base import QNNLossBase
+
+class CrossEntropyLoss(QNNLossBase):
+    """Cross-entropy loss for QNN classification."""
+
+    def __init__(self, eps: float = 1e-8):
+        super().__init__()
+        self.eps = eps
+
+    def value(self, value_dict: dict, **kwargs) -> float:
+        """Computes the cross-entropy loss."""
+        f = value_dict["f"]
+        y = kwargs.get("ground_truth")
+        f = np.clip(f, self.eps, 1.0 - self.eps)
+        
+        if y.ndim == 1 or y.shape[1] == 1:
+            # Binary cross entropy
+            y = y.ravel()
+            f = f.ravel()
+            loss = -np.mean(y * np.log(f) + (1.0 - y) * np.log(1.0 - f))
+        else:
+            # Categorical cross entropy
+            loss = -np.mean(np.sum(y * np.log(f), axis=1))
+        return loss
+
+    def gradient(self, value_dict: dict, **kwargs) -> np.ndarray:
+        """Computes the gradient of the cross-entropy loss."""
+        f = value_dict["f"]
+        df = value_dict["df_dp"]
+        y = kwargs.get("ground_truth")
+        f = np.clip(f, self.eps, 1.0 - self.eps)
+
+        if y.ndim == 1 or y.shape[1] == 1:
+            y = y.reshape(-1, 1)
+            f = f.reshape(-1, 1)
+            # Gradient of BCE: (f - y) / (f * (1 - f))
+            grad_factor = (f - y) / (f * (1.0 - f))
+        else:
+            # Gradient of CCE: -y / f
+            grad_factor = -y / f
+
+        # df has shape (n_samples, n_outputs, n_param)
+        # grad_factor has shape (n_samples, n_outputs)
+        return np.mean(np.sum(grad_factor[:, :, np.newaxis] * df, axis=1), axis=0)
