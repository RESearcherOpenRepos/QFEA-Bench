+++ b/src/squlearn/util/serialization/serializable_model_mixin.py
@@ -0,0 +1,236 @@
+"""Serialization support for trained squlearn models.
+
+The executor often owns live backend/session/primitive objects that should not be
+part of a persisted model.  This mixin temporarily removes every reference to an
+:class:`~squlearn.util.executor.Executor` found in the object graph, pickles the
+model, and restores the references afterwards.  Loading performs the inverse
+operation by inserting the executor supplied by the caller at all recorded
+locations.
+"""
+
+from __future__ import annotations
+
+import io
+import pickle
+from typing import Any
+
+from squlearn.util.executor import Executor
+
+
+class _ExecutorPlaceholder:
+    """Pickleable sentinel used in place of executor instances."""
+
+
+_PLACEHOLDER = _ExecutorPlaceholder()
+
+
+class SerializableModelMixin:
+    """Mixin adding executor-free pickle serialization to model classes."""
+
+    def dump(self, target) -> None:
+        """Serialize the model to *target*.
+
+        Args:
+            target: String/path-like file name or binary ``IOBase`` stream.
+
+        Raises:
+            TypeError: If *target* is not a supported output object.
+        """
+
+        replacements = []
+        self._replace_executors(self, _PLACEHOLDER, replacements, set())
+        try:
+            if isinstance(target, (str, bytes, bytearray)) or hasattr(target, "__fspath__"):
+                with open(target, "wb") as file:
+                    pickle.dump(self, file, protocol=pickle.HIGHEST_PROTOCOL)
+            elif isinstance(target, io.IOBase) and target.writable():
+                pickle.dump(self, target, protocol=pickle.HIGHEST_PROTOCOL)
+            else:
+                raise TypeError("target must be a file path or writable binary IOBase stream")
+        finally:
+            for container, key, value in reversed(replacements):
+                self._assign(container, key, value)
+
+    @classmethod
+    def load(cls, source, executor: Executor):
+        """Load a serialized model from *source* and insert *executor*.
+
+        Args:
+            source: String/path-like file name or binary ``IOBase`` stream.
+            executor: Executor instance to use for all restored executor references.
+
+        Returns:
+            The restored model instance.
+
+        Raises:
+            TypeError: If *source*, *executor*, or the loaded object type is unsupported.
+        """
+
+        if not isinstance(executor, Executor):
+            raise TypeError("executor must be an Executor instance")
+        if isinstance(source, (str, bytes, bytearray)) or hasattr(source, "__fspath__"):
+            with open(source, "rb") as file:
+                model = pickle.load(file)
+        elif isinstance(source, io.IOBase) and source.readable():
+            model = pickle.load(source)
+        else:
+            raise TypeError("source must be a file path or readable binary IOBase stream")
+
+        if not isinstance(model, cls):
+            raise TypeError(f"serialized object is not an instance of {cls.__name__}")
+        cls._replace_placeholders(model, executor, set())
+        return model
+
+    @classmethod
+    def _replace_executors(cls, obj: Any, placeholder: Any, replacements: list, seen: set) -> None:
+        if isinstance(obj, Executor) or id(obj) in seen:
+            return
+        seen.add(id(obj))
+
+        if isinstance(obj, dict):
+            for key, value in list(obj.items()):
+                if isinstance(value, Executor):
+                    replacements.append((obj, key, value))
+                    obj[key] = placeholder
+                elif isinstance(value, tuple) and cls._contains_executor(value, set()):
+                    replacements.append((obj, key, value))
+                    obj[key] = cls._tuple_replace(value, placeholder, set())
+                else:
+                    cls._replace_executors(value, placeholder, replacements, seen)
+            return
+        if isinstance(obj, list):
+            for index, value in enumerate(obj):
+                if isinstance(value, Executor):
+                    replacements.append((obj, index, value))
+                    obj[index] = placeholder
+                elif isinstance(value, tuple) and cls._contains_executor(value, set()):
+                    replacements.append((obj, index, value))
+                    obj[index] = cls._tuple_replace(value, placeholder, set())
+                else:
+                    cls._replace_executors(value, placeholder, replacements, seen)
+            return
+        if isinstance(obj, set):
+            for value in list(obj):
+                if isinstance(value, Executor):
+                    obj.remove(value)
+                    obj.add(placeholder)
+                    replacements.append((obj, placeholder, value))
+                else:
+                    cls._replace_executors(value, placeholder, replacements, seen)
+            return
+        if isinstance(obj, tuple):
+            return
+        state = getattr(obj, "__dict__", None)
+        if state is not None:
+            for key, value in list(state.items()):
+                if isinstance(value, Executor):
+                    replacements.append((state, key, value))
+                    state[key] = placeholder
+                elif isinstance(value, tuple) and cls._contains_executor(value, set()):
+                    replacements.append((state, key, value))
+                    state[key] = cls._tuple_replace(value, placeholder, set())
+                    cls._replace_executors(state[key], placeholder, replacements, seen)
+                else:
+                    cls._replace_executors(value, placeholder, replacements, seen)
+
+    @classmethod
+    def _replace_placeholders(cls, obj: Any, executor: Executor, seen: set) -> None:
+        if id(obj) in seen:
+            return
+        seen.add(id(obj))
+        if isinstance(obj, dict):
+            for key, value in list(obj.items()):
+                if isinstance(value, _ExecutorPlaceholder):
+                    obj[key] = executor
+                elif isinstance(value, tuple) and cls._contains_placeholder(value, set()):
+                    obj[key] = cls._tuple_restore(value, executor, set())
+                else:
+                    cls._replace_placeholders(value, executor, seen)
+            return
+        if isinstance(obj, list):
+            for index, value in enumerate(obj):
+                if isinstance(value, _ExecutorPlaceholder):
+                    obj[index] = executor
+                elif isinstance(value, tuple) and cls._contains_placeholder(value, set()):
+                    obj[index] = cls._tuple_restore(value, executor, set())
+                else:
+                    cls._replace_placeholders(value, executor, seen)
+            return
+        if isinstance(obj, set):
+            for value in list(obj):
+                if isinstance(value, _ExecutorPlaceholder):
+                    obj.remove(value)
+                    obj.add(executor)
+                else:
+                    cls._replace_placeholders(value, executor, seen)
+            return
+        if isinstance(obj, tuple):
+            return
+        state = getattr(obj, "__dict__", None)
+        if state is not None:
+            for key, value in list(state.items()):
+                if isinstance(value, _ExecutorPlaceholder):
+                    state[key] = executor
+                elif isinstance(value, tuple) and cls._contains_placeholder(value, set()):
+                    state[key] = cls._tuple_restore(value, executor, set())
+                    cls._replace_placeholders(state[key], executor, seen)
+                else:
+                    cls._replace_placeholders(value, executor, seen)
+
+    @classmethod
+    def _contains_executor(cls, obj: Any, seen: set) -> bool:
+        if isinstance(obj, Executor):
+            return True
+        if id(obj) in seen:
+            return False
+        seen.add(id(obj))
+        if isinstance(obj, (tuple, list, set)):
+            return any(cls._contains_executor(v, seen) for v in obj)
+        if isinstance(obj, dict):
+            return any(cls._contains_executor(v, seen) for v in obj.values())
+        return any(cls._contains_executor(v, seen) for v in getattr(obj, "__dict__", {}).values())
+
+    @classmethod
+    def _contains_placeholder(cls, obj: Any, seen: set) -> bool:
+        if isinstance(obj, _ExecutorPlaceholder):
+            return True
+        if id(obj) in seen:
+            return False
+        seen.add(id(obj))
+        if isinstance(obj, (tuple, list, set)):
+            return any(cls._contains_placeholder(v, seen) for v in obj)
+        if isinstance(obj, dict):
+            return any(cls._contains_placeholder(v, seen) for v in obj.values())
+        return any(cls._contains_placeholder(v, seen) for v in getattr(obj, "__dict__", {}).values())
+
+    @classmethod
+    def _tuple_replace(cls, obj: tuple, placeholder: Any, seen: set) -> tuple:
+        values = []
+        for value in obj:
+            if isinstance(value, Executor):
+                values.append(placeholder)
+            elif isinstance(value, tuple):
+                values.append(cls._tuple_replace(value, placeholder, seen))
+            else:
+                values.append(value)
+        return tuple(values)
+
+    @classmethod
+    def _tuple_restore(cls, obj: tuple, executor: Executor, seen: set) -> tuple:
+        values = []
+        for value in obj:
+            if isinstance(value, _ExecutorPlaceholder):
+                values.append(executor)
+            elif isinstance(value, tuple):
+                values.append(cls._tuple_restore(value, executor, seen))
+            else:
+                values.append(value)
+        return tuple(values)
+
+    @staticmethod
+    def _assign(container: Any, key: Any, value: Any) -> None:
+        if isinstance(container, set):
+            container.remove(key)
+            container.add(value)
+        else:
+            container[key] = value
