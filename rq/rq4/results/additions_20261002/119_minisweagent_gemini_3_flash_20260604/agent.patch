@@ -0,0 +1,85 @@
+import dill as pickle
+import io
+from typing import Union
+from pathlib import Path
+from ..executor import Executor
+
+class SerializableModelMixin:
+    """Mixin class for serialization of models."""
+
+    def dump(self, target: Union[str, Path, io.IOBase]):
+        """
+        Serializes the model and saves it to a file or a binary stream.
+
+        Args:
+            target (Union[str, Path, io.IOBase]): The file path or binary stream to save the model to.
+        """
+        # Custom Pickler to skip Executor instances
+        class ExecutorExcludingPickler(pickle.Pickler):
+            def save(self, obj):
+                if isinstance(obj, Executor):
+                    # Replace Executor with None during serialization
+                    return super().save(None)
+                return super().save(obj)
+
+        if isinstance(target, (str, Path)):
+            with open(target, "wb") as f:
+                ExecutorExcludingPickler(f).dump(self)
+        elif isinstance(target, io.IOBase):
+            ExecutorExcludingPickler(target).dump(self)
+        else:
+            raise TypeError("target must be a file path or a binary stream")
+
+    @classmethod
+    def load(cls, source: Union[str, Path, io.IOBase], executor: Executor):
+        """
+        Loads a model from a file or a binary stream and reinserts the executor.
+
+        Args:
+            source (Union[str, Path, io.IOBase]): The file path or binary stream to load the model from.
+            executor (Executor): The executor to reinsert into the model.
+
+        Returns:
+            The loaded model instance.
+        """
+        if not isinstance(executor, Executor):
+            raise TypeError("executor must be an instance of Executor")
+
+        if isinstance(source, (str, Path)):
+            with open(source, "rb") as f:
+                model = pickle.load(f)
+        elif isinstance(source, io.IOBase):
+            model = pickle.load(source)
+        else:
+            raise TypeError("source must be a file path or a binary stream")
+
+        if not isinstance(model, cls):
+            raise TypeError(f"Loaded object is not an instance of {cls.__name__}")
+
+        # Helper function to recursively reinsert Executor instances
+        # We use a set to keep track of visited objects to avoid infinite recursion
+        visited = set()
+
+        def reinsert_executor(obj):
+            if id(obj) in visited:
+                return
+            visited.add(id(obj))
+
+            if isinstance(obj, dict):
+                for k, v in obj.items():
+                    if v is None and k in ["executor", "_executor"]:
+                        obj[k] = executor
+                    else:
+                        reinsert_executor(v)
+            elif isinstance(obj, list):
+                for i in obj:
+                    reinsert_executor(i)
+            elif hasattr(obj, "__dict__"):
+                for k, v in obj.__dict__.items():
+                    if v is None and k in ["executor", "_executor"]:
+                        setattr(obj, k, executor)
+                    else:
+                        reinsert_executor(v)
+
+        reinsert_executor(model)
+        return model
