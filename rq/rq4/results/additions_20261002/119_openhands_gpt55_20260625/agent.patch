--- /dev/null
+++ b/src/squlearn/util/serialization/serializable_model_mixin.py
@@ -0,0 +1,92 @@
+"""Serialization support for trained squlearn models."""
+
+from __future__ import annotations
+
+import copy
+import io
+import pickle
+from os import PathLike
+from typing import Any, BinaryIO, Union
+
+from squlearn.util.executor import Executor
+
+
+_EXECUTOR_SENTINEL = {"__squlearn_executor__": True}
+
+
+class SerializableModelMixin:
+    """Mixin adding executor-free pickle serialization to model classes."""
+
+    def dump(self, target: Union[str, PathLike, BinaryIO]) -> None:
+        """Serialize this model to a path or binary stream without executor instances."""
+        payload = _replace_executors(copy.deepcopy(self), _EXECUTOR_SENTINEL, {})
+        if isinstance(target, (str, PathLike)):
+            with open(target, "wb") as file:
+                pickle.dump(payload, file)
+            return
+        if isinstance(target, io.IOBase) and target.writable():
+            pickle.dump(payload, target)
+            return
+        raise TypeError("target must be a file path or writable binary IOBase stream")
+
+    @classmethod
+    def load(cls, source: Union[str, PathLike, BinaryIO], executor: Executor):
+        """Restore a model from a path or binary stream and insert the supplied executor."""
+        if not isinstance(executor, Executor):
+            raise TypeError("executor must be an Executor instance")
+        if isinstance(source, (str, PathLike)):
+            with open(source, "rb") as file:
+                model = pickle.load(file)
+        elif isinstance(source, io.IOBase) and source.readable():
+            model = pickle.load(source)
+        else:
+            raise TypeError("source must be a file path or readable binary IOBase stream")
+        if not isinstance(model, cls):
+            raise TypeError(f"serialized object is not an instance of {cls.__name__}")
+        return _replace_executors(model, executor, {})
+
+
+def _replace_executors(obj: Any, replacement: Any, memo: dict[int, Any]) -> Any:
+    obj_id = id(obj)
+    if obj_id in memo:
+        return memo[obj_id]
+
+    if isinstance(obj, Executor) or obj == _EXECUTOR_SENTINEL:
+        return replacement
+
+    if isinstance(obj, dict):
+        memo[obj_id] = obj
+        for key, value in list(obj.items()):
+            new_key = _replace_executors(key, replacement, memo)
+            new_value = _replace_executors(value, replacement, memo)
+            if new_key is not key:
+                del obj[key]
+                obj[new_key] = new_value
+            else:
+                obj[key] = new_value
+        return obj
+
+    if isinstance(obj, list):
+        memo[obj_id] = obj
+        obj[:] = [_replace_executors(value, replacement, memo) for value in obj]
+        return obj
+
+    if isinstance(obj, set):
+        memo[obj_id] = obj
+        values = [_replace_executors(value, replacement, memo) for value in obj]
+        obj.clear()
+        obj.update(values)
+        return obj
+
+    if isinstance(obj, tuple):
+        converted = tuple(_replace_executors(value, replacement, memo) for value in obj)
+        memo[obj_id] = converted
+        return converted
+
+    if hasattr(obj, "__dict__"):
+        memo[obj_id] = obj
+        for key, value in vars(obj).items():
+            setattr(obj, key, _replace_executors(value, replacement, memo))
+        return obj
+
+    return obj
