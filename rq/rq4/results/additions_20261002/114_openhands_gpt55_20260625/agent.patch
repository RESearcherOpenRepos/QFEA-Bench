+"""Cross-entropy loss for QNN classifiers."""
+
+from typing import Union
+
+import numpy as np
+
+from .qnn_loss_base import QNNLossBase
+
+
+class CrossEntropyLoss(QNNLossBase):
+    """Cross-entropy loss for probability-valued classifier outputs."""
+
+    def __init__(self, eps: float = 1e-8):
+        super().__init__()
+        self.eps = eps
+
+    @property
+    def loss_args_tuple(self) -> tuple:
+        """Returns evaluation tuple for cross-entropy loss calculation."""
+        return ("f",)
+
+    @property
+    def gradient_args_tuple(self) -> tuple:
+        """Returns evaluation tuple for cross-entropy loss gradient calculation."""
+        if self._opt_param_op:
+            return ("f", "dfdp", "dfdop")
+        return ("f", "dfdp")
+
+    def value(self, value_dict: dict, **kwargs) -> float:
+        """Calculates binary or multiple-output cross-entropy loss."""
+        if "ground_truth" not in kwargs:
+            raise AttributeError("CrossEntropyLoss requires ground_truth.")
+
+        ground_truth = np.asarray(kwargs["ground_truth"])
+        f = np.clip(np.asarray(value_dict["f"]), self.eps, 1.0 - self.eps)
+        weights = self._get_weights(ground_truth, kwargs)
+
+        if self._is_multiple_output(f, ground_truth, kwargs):
+            return -np.sum(weights * ground_truth * np.log(f))
+
+        return -np.sum(weights * (ground_truth * np.log(f) + (1 - ground_truth) * np.log(1 - f)))
+
+    def gradient(
+        self, value_dict: dict, **kwargs
+    ) -> Union[np.ndarray, tuple[np.ndarray, np.ndarray]]:
+        """Calculates gradients from supplied model-output derivatives."""
+        if "ground_truth" not in kwargs:
+            raise AttributeError("CrossEntropyLoss requires ground_truth.")
+
+        ground_truth = np.asarray(kwargs["ground_truth"])
+        f = np.clip(np.asarray(value_dict["f"]), self.eps, 1.0 - self.eps)
+        weights = self._get_weights(ground_truth, kwargs)
+        multiple_output = self._is_multiple_output(f, ground_truth, kwargs)
+
+        if multiple_output:
+            diff = -weights * ground_truth / f
+            d_p = self._contract_multiple(diff, value_dict["dfdp"])
+        else:
+            diff = weights * ((1 - ground_truth) / (1 - f) - ground_truth / f)
+            d_p = self._contract_single(diff, value_dict["dfdp"])
+
+        if not self._opt_param_op:
+            return d_p
+
+        if multiple_output:
+            d_op = self._contract_multiple(diff, value_dict["dfdop"])
+        else:
+            d_op = self._contract_single(diff, value_dict["dfdop"])
+        return d_p, d_op
+
+    def _get_weights(self, ground_truth: np.ndarray, kwargs: dict) -> np.ndarray:
+        if "weights" in kwargs and kwargs["weights"] is not None:
+            return np.asarray(kwargs["weights"])
+        return np.ones_like(ground_truth)
+
+    def _is_multiple_output(self, f: np.ndarray, ground_truth: np.ndarray, kwargs: dict) -> bool:
+        return bool(kwargs.get("multiple_output", False)) or (f.ndim > 1 and ground_truth.ndim > 1)
+
+    def _contract_single(self, diff: np.ndarray, derivative: np.ndarray) -> np.ndarray:
+        if derivative.shape[0] == 0:
+            return np.array([])
+        return np.einsum("j,jk->k", diff, derivative)
+
+    def _contract_multiple(self, diff: np.ndarray, derivative: np.ndarray) -> np.ndarray:
+        if derivative.shape[0] == 0:
+            return np.array([])
+        return np.einsum("ij,ijk->k", diff, derivative)
