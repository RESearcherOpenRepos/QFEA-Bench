+"""Quantum Kernel Optimizer"""
+
+import numpy as np
+from functools import partial
+from typing import Optional, Sequence
+from .kernel_matrix_base import KernelMatrixBase
+from ..loss.kernel_loss_base import KernelLossBase
+from ...optimizers.optimizer_base import OptimizerBase
+
+
+class KernelOptimizer:
+    """
+    Quantum kernel optimizer.
+    This class can be used to optimize the variational parameters of a quantum kernel.
+
+    Wraps a quantum kernel and exposes fitted state and optimized parameters.
+    When passed as the ``quantum_kernel`` argument to a supported model
+    (:class:`QGPR`, :class:`QKRR`, :class:`QSVR`, :class:`QGPC`, :class:`QSVC`),
+    the model's ``fit`` method will automatically run the kernel optimization
+    before fitting the model.
+
+    Args:
+        quantum_kernel (KernelMatrixBase): The quantum kernel to be optimized
+            (either a fidelity quantum kernel (FQK) or projected quantum kernel (PQK)).
+        loss (KernelLossBase, optional): The loss function to be minimized.
+            Default: :class:`NLL` for fidelity kernels, :class:`TargetAlignment`
+            for projected kernels.
+        optimizer (OptimizerBase): The optimizer to be used.
+        initial_parameters (Optional[Sequence[float]]): Initial parameters for the optimizer.
+            If None, the current kernel parameters are used.
+
+    Attributes:
+        optimal_value (float): The optimal value of the loss function after fitting.
+        optimal_point (np.ndarray): The optimal point of the loss function after fitting.
+
+    **Example**
+
+    .. code-block::
+
+        from squlearn import Executor
+        from squlearn.encoding_circuit import HubregtsenEncodingCircuit
+        from squlearn.kernel.matrix import FidelityKernel
+        from squlearn.optimizers import Adam
+        from squlearn.kernel.optimization import NLL
+        enc_circ = HubregtsenEncodingCircuit(num_qubits=num_qubits, num_features=num_features, num_layers=2)
+        q_kernel = FidelityKernel(encoding_circuit=enc_circ, executor=Executor())
+        adam = Adam(options={"maxiter": 20, "lr": 0.1})
+        nll_loss = NLL(sigma=noise_std**2)
+        optimizer = KernelOptimizer(quantum_kernel=q_kernel, loss=nll_loss, optimizer=adam)
+        # Use with a model - optimization runs automatically during fit:
+        qgpr = QGPR(quantum_kernel=optimizer)
+        qgpr.fit(X_train, y_train)
+        optimal_params = optimizer.get_optimal_parameters()
+
+    Methods:
+    ----------
+    """
+
+    def __init__(
+        self,
+        quantum_kernel: KernelMatrixBase,
+        loss: KernelLossBase = None,
+        optimizer: OptimizerBase = None,
+        initial_parameters: Optional[Sequence[float]] = None,
+    ) -> None:
+        self._quantum_kernel = quantum_kernel
+        self._loss = loss
+        self._optimizer = optimizer
+        self._initial_parameters = initial_parameters
+        self._opt_result = None
+        self._optimizer_evals = None
+        self._optimal_value = None
+        self._optimal_point = None
+        self._optimal_parameters = None
+
+        if self._loss is not None:
+            self._loss._quantum_kernel = self._quantum_kernel
+
+        if self._initial_parameters is None:
+            self._initial_parameters = self._quantum_kernel.parameters
+
+    def run_optimization(self, X: np.ndarray, y: np.ndarray = None):
+        """Run the optimization and return the result.
+
+        Args:
+            X (np.ndarray): The input data.
+            y (np.ndarray): The labels.
+
+        Returns:
+            OptimizeResult: The optimization result.
+        """
+        num_params = self._quantum_kernel.num_parameters
+        if num_params == 0:
+            raise ValueError(
+                "Quantum kernel cannot be fit because there are no training parameters specified."
+            )
+
+        # Perform kernel optimization
+        loss_function = partial(self._loss.compute, data=X, labels=y)
+        opt_result = self._optimizer.minimize(fun=loss_function, x0=self._initial_parameters)
+        self._optimal_value = opt_result.fun
+        self._optimal_point = opt_result.x
+        self._optimal_parameters = opt_result.x
+        self._opt_result = opt_result
+
+        # Assign the optimal parameters to the quantum kernel
+        self._quantum_kernel.assign_parameters(self._optimal_parameters)
+
+        return self._opt_result
+
+    def get_optimal_parameters(self) -> np.ndarray:
+        """Returns the optimized kernel parameters after fitting.
+
+        Returns:
+            numpy.ndarray: The optimized kernel parameters.
+        """
+        return self._optimal_parameters
+
+    @property
+    def quantum_kernel(self) -> KernelMatrixBase:
+        """Returns the wrapped quantum kernel."""
+        return self._quantum_kernel
+
+    @property
+    def optimal_value(self) -> float:
+        """Returns the optimal value of the loss function."""
+        return self._optimal_value
+
+    @property
+    def optimal_point(self) -> np.ndarray:
+        """Returns the optimal point of the loss function."""
+        return self._optimal_point
