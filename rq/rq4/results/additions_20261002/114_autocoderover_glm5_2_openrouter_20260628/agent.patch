@@ -0,0 +1,140 @@
+"""Cross-entropy loss for QNNs."""
+
+import numpy as np
+
+from .qnn_loss_base import QNNLossBase
+
+
+class CrossEntropyLoss(QNNLossBase):
+    """Cross-entropy loss for quantum neural network classifiers.
+
+    Supports both binary classification (single observable output) and
+    multi-class classification (multiple observable outputs).
+
+    Args:
+        eps (float, default=1e-8): Small constant for numerical clipping to
+            avoid log(0).
+    """
+
+    def __init__(self, eps: float = 1e-8):
+        super().__init__()
+        self.eps = eps
+        self._opt_param_op = True
+
+    def set_opt_param_op(self, opt_param_op: bool = True) -> None:
+        """Select whether observable parameters are optimized.
+
+        Args:
+            opt_param_op (bool, default=True): If True, observable parameters
+                are optimized.
+        """
+        self._opt_param_op = opt_param_op
+
+    def value(self, value_dict: dict, **kwargs) -> float:
+        """Compute the cross-entropy loss.
+
+        Args:
+            value_dict (dict): Dictionary containing the model output under
+                the key ``"f"``.
+            **kwargs: Additional keyword arguments. Must contain
+                ``ground_truth`` and may contain ``multiple_output``.
+
+        Returns:
+            float: The cross-entropy loss value.
+        """
+        ground_truth = kwargs.get("ground_truth")
+        multiple_output = kwargs.get("multiple_output", False)
+
+        f = np.asarray(value_dict["f"], dtype=float)
+        ground_truth = np.asarray(ground_truth, dtype=float)
+
+        if multiple_output or f.ndim > 1:
+            # Multi-class: f has shape (n_samples, n_classes)
+            if f.ndim == 1:
+                f = f.reshape(-1, 1)
+            if ground_truth.ndim == 1:
+                ground_truth = ground_truth.reshape(-1, 1)
+            # Clip for numerical stability
+            f_clipped = np.clip(f, self.eps, 1.0 - self.eps)
+            loss = -np.mean(np.sum(ground_truth * np.log(f_clipped), axis=1))
+        else:
+            # Binary: f has shape (n_samples,)
+            f_clipped = np.clip(f, self.eps, 1.0 - self.eps)
+            loss = -np.mean(
+                ground_truth * np.log(f_clipped)
+                + (1.0 - ground_truth) * np.log(1.0 - f_clipped)
+            )
+
+        return float(loss)
+
+    def gradient(self, value_dict: dict, **kwargs) -> np.ndarray:
+        """Compute the parameter gradients of the cross-entropy loss.
+
+        Args:
+            value_dict (dict): Dictionary containing the model output under
+                the key ``"f"`` and its derivatives under ``"df"`` (and
+                ``"df_op"`` if observable parameters are optimized).
+            **kwargs: Additional keyword arguments. Must contain
+                ``ground_truth`` and may contain ``multiple_output``.
+
+        Returns:
+            np.ndarray: The gradients with respect to the parameters (and
+            observable parameters if applicable).
+        """
+        ground_truth = kwargs.get("ground_truth")
+        multiple_output = kwargs.get("multiple_output", False)
+
+        f = np.asarray(value_dict["f"], dtype=float)
+        ground_truth = np.asarray(ground_truth, dtype=float)
+        df = np.asarray(value_dict["df"], dtype=float)
+
+        if multiple_output or f.ndim > 1:
+            # Multi-class: f has shape (n_samples, n_classes)
+            if f.ndim == 1:
+                f = f.reshape(-1, 1)
+            if ground_truth.ndim == 1:
+                ground_truth = ground_truth.reshape(-1, 1)
+            f_clipped = np.clip(f, self.eps, 1.0 - self.eps)
+            # dL/df = -ground_truth / f
+            dL_df = -ground_truth / f_clipped
+            # df has shape (n_samples, n_params, n_classes) or
+            # (n_samples, n_classes, n_params)
+            # We need to contract over samples and classes
+            if df.ndim == 3:
+                if df.shape[1] == f.shape[1]:
+                    # df shape: (n_samples, n_classes, n_params)
+                    grad = np.einsum("sc,scp->p", dL_df, df) / f.shape[0]
+                else:
+                    # df shape: (n_samples, n_params, n_classes)
+                    grad = np.einsum("sc,spc->p", dL_df, df) / f.shape[0]
+            else:
+                grad = np.zeros(df.shape[-1])
+        else:
+            # Binary: f has shape (n_samples,)
+            f_clipped = np.clip(f, self.eps, 1.0 - self.eps)
+            # dL/df = -(ground_truth / f - (1 - ground_truth) / (1 - f))
+            dL_df = -(ground_truth / f_clipped - (1.0 - ground_truth) / (1.0 - f_clipped))
+            # df has shape (n_samples, n_params)
+            if df.ndim == 2:
+                grad = np.einsum("s,sp->p", dL_df, df) / f.shape[0]
+            else:
+                grad = np.zeros(df.shape[-1] if df.ndim > 0 else 1)
+
+        if self._opt_param_op and "df_op" in value_dict:
+            df_op = np.asarray(value_dict["df_op"], dtype=float)
+            if multiple_output or f.ndim > 1:
+                if df_op.ndim == 3:
+                    if df_op.shape[1] == f.shape[1]:
+                        grad_op = np.einsum("sc,scp->p", dL_df, df_op) / f.shape[0]
+                    else:
+                        grad_op = np.einsum("sc,spc->p", dL_df, df_op) / f.shape[0]
+                else:
+                    grad_op = np.zeros(df_op.shape[-1])
+            else:
+                if df_op.ndim == 2:
+                    grad_op = np.einsum("s,sp->p", dL_df, df_op) / f.shape[0]
+                else:
+                    grad_op = np.zeros(df_op.shape[-1] if df_op.ndim > 0 else 1)
+            return np.concatenate([grad, grad_op])
+
+        return grad
