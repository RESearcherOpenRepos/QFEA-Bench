diff --git a/src/squlearn/qnn/base_qnn.py b/src/squlearn/qnn/base_qnn.py
index 29518e2..15916c0 100644
--- a/src/squlearn/qnn/base_qnn.py
+++ b/src/squlearn/qnn/base_qnn.py
@@ -117,3 +117,79 @@ class BaseQNN(BaseEstimator, ABC):
     def _fit(self, X: np.ndarray, y: np.ndarray, weights: np.ndarray = None) -> None:
         """Internal fit function."""
         raise NotImplementedError()
+
+    def get_params(self, deep: bool = True) -> dict:
+        """Returns the dictionary of the hyper-parameters of the QNN.
+
+        Args:
+            deep (bool): If True, also the parameters for
+                         contained objects are returned (default=True).
+
+        Returns:
+            dict: Dictionary with hyper-parameters and values.
+        """
+        params = super().get_params(deep=False)
+        params.update(self._qnn.get_params(deep=deep))
+        if not deep:
+            # Add the objects themselves if not deep
+            params["pqc"] = self.pqc
+            params["operator"] = self.operator
+            params["loss"] = self.loss
+            params["optimizer"] = self.optimizer
+            params["executor"] = self.executor
+        return params
+
+    def set_params(self, **params) -> "BaseQNN":
+        """Sets the hyper-parameters of the QNN.
+
+        Args:
+            params: Hyper-parameters and their values, e.g. ``num_qubits=2``.
+
+        Returns:
+            BaseQNN: The updated QNN instance.
+        """
+        # Check if pqc or operator are in params and update them first
+        if "pqc" in params:
+            self.pqc = params.pop("pqc")
+            self.param_ini = self.pqc.generate_initial_parameters(seed=self.parameter_seed)
+            self.param = self.param_ini.copy()
+            self._qnn.pqc = self._qnn.pqc.__class__(self.pqc, self._qnn.backend)
+        if "operator" in params:
+            self.operator = params.pop("operator")
+            if isinstance(self.operator, list):
+                self.param_op_ini = np.concatenate(
+                    [op.generate_initial_parameters(seed=self.parameter_seed) for op in self.operator]
+                )
+            else:
+                self.param_op_ini = self.operator.generate_initial_parameters(seed=self.parameter_seed)
+            self.param_op = self.param_op_ini.copy()
+            self._qnn.operator = self.operator
+
+        # Update other parameters
+        super().set_params(**params)
+
+        # Update the internal QNN
+        self._qnn.set_params(**params)
+
+        # Re-initialize parameters if pqc or operator hyperparameters were changed
+        # (e.g. num_qubits, num_layers)
+        # We check if the number of parameters has changed
+        if len(self.param) != self.pqc.num_parameters:
+            self.param_ini = self.pqc.generate_initial_parameters(seed=self.parameter_seed)
+            self.param = self.param_ini.copy()
+
+        if isinstance(self.operator, list):
+            num_op_params = sum([op.num_parameters for op in self.operator])
+        else:
+            num_op_params = self.operator.num_parameters
+
+        if len(self.param_op) != num_op_params:
+            if isinstance(self.operator, list):
+                self.param_op_ini = np.concatenate(
+                    [op.generate_initial_parameters(seed=self.parameter_seed) for op in self.operator]
+                )
+            else:
+                self.param_op_ini = self.operator.generate_initial_parameters(seed=self.parameter_seed)
+            self.param_op = self.param_op_ini.copy()
+
+        return self
