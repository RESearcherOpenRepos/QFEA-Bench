                 kernel=self.quantum_kernel.evaluate,
                 **kwargs,
             )
+        elif isinstance(self.quantum_kernel, KernelOptimizer):
+            # For KernelOptimizer, we'll handle the kernel in fit()
+            super().__init__(kernel="precomputed", **kwargs)
         else:
             super().__init__(kernel="precomputed", **kwargs)
 
+    def fit(self, X, y, sample_weight=None):
+        """Fit the SVM model according to the given training data.
+
+        Args:
+            X : Training vectors, where n_samples is the number of samples
+                and n_features is the number of features.
+            y : Target values (class labels in classification, real numbers in
+                regression)
+            sample_weight : Per-sample weights. Rescale C per sample. Higher weights
+                force the classifier to put more emphasis on these points.
+
+        Returns:
+            self : object
+        """
+        # Handle KernelOptimizer wrapper
+        if isinstance(self.quantum_kernel, KernelOptimizer):
+            self._kernel_optimizer = self.quantum_kernel
+            self._kernel_optimizer.run_optimization(X, y)
+            self.quantum_kernel = self._kernel_optimizer._quantum_kernel
+            self._optimal_parameters = self._kernel_optimizer.get_optimal_parameters()
+            # Set the kernel to the optimized kernel's evaluate method
+            self.kernel = self.quantum_kernel.evaluate
+
+        return super().fit(X, y, sample_weight=sample_weight)
+
     @classmethod
     def _get_param_names(cls):
         names = SVC._get_param_names()
