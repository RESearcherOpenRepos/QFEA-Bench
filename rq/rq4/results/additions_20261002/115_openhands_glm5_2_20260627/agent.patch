+    def _repeat_mixer_gate_maps(self, n_repetitions: int) -> List[List]:
+        """Repeat the custom mixer gate maps across the QAOA layers, assigning
+        consistent ``pauli_label`` indices so that single-qubit and two-qubit
+        terms keep their separation and ordering across layers."""
+
+        from copy import deepcopy
+
+        mixer_1q_gate_maps, mixer_2q_gate_maps = self._mixer_gate_maps
+
+        output_gate_list = []
+
+        for each_repetition in range(n_repetitions):
+            layer_gates = []
+            one_qubit_count = 0
+            two_qubit_count = 0
+            for each_gate in mixer_1q_gate_maps:
+                gate_copy = deepcopy(each_gate)
+                gate_copy.pauli_label = ['mixer', each_repetition,
+                                         one_qubit_count]
+                one_qubit_count += 1
+                layer_gates.append(gate_copy)
+            for each_gate in mixer_2q_gate_maps:
+                gate_copy = deepcopy(each_gate)
+                gate_copy.pauli_label = ['mixer', each_repetition,
+                                         two_qubit_count]
+                two_qubit_count += 1
+                layer_gates.append(gate_copy)
+            output_gate_list.append(layer_gates)
+
+        return output_gate_list
