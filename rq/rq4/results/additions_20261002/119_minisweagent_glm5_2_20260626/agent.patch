+++ b/src/squlearn/util/serialization/serializable_model_mixin.py
@@ -0,0 +1,130 @@
+"""Mixin that supplies save/restore functionality to supported quantum-learning models.
+
+The mixin serializes the model with :mod:`dill` while stripping every
+:class:`~squlearn.util.executor.Executor` reference from the payload.  On load the
+caller supplies a fresh :class:`~squlearn.util.executor.Executor` instance which is
+reinserted into every position that previously held an executor (including repeated
+or nested references).
+"""
+
+from __future__ import annotations
+
+import io
+import os
+from io import IOBase
+from typing import Any, Union
+
+import dill
+
+from ...util.executor import Executor
+
+# Sentinel persisted in place of an :class:`Executor` instance.
+_EXECUTOR_SENTINEL = "__squlearn_executor_placeholder__"
+
+
+class _ExecutorPickler(dill.Pickler):
+    """Dill pickler that replaces :class:`Executor` instances with a sentinel."""
+
+    def persistent_id(self, obj: Any):
+        if isinstance(obj, Executor):
+            return _EXECUTOR_SENTINEL
+        return None
+
+
+class _ExecutorUnpickler(dill.Unpickler):
+    """Dill unpickler that reinserts the supplied executor for every sentinel."""
+
+    def __init__(self, file, executor: Executor):
+        super().__init__(file)
+        self._executor = executor
+
+    def persistent_load(self, pid):
+        if pid == _EXECUTOR_SENTINEL:
+            return self._executor
+        raise dill.UnpicklingError(f"Unsupported persistent id encountered: {pid!r}")
+
+
+def _is_path(target: Any) -> bool:
+    return isinstance(target, (str, os.PathLike))
+
+
+def _is_binary_stream(target: Any) -> bool:
+    """Return ``True`` for binary file-like objects (readable or writable)."""
+    if _is_path(target):
+        return False
+    if not hasattr(target, "read") and not hasattr(target, "write"):
+        return False
+    # Reject text streams (e.g. io.StringIO) explicitly.
+    if isinstance(target, io.TextIOBase):
+        return False
+    # ``IOBase`` covers BytesIO and real binary files.
+    if isinstance(target, IOBase):
+        return True
+    # Fall back to duck-typing for objects that look like binary streams.
+    return hasattr(target, "write") and hasattr(target, "read")
+
+
+class SerializableModelMixin:
+    """Mixin adding :meth:`dump` / :meth:`load` to quantum-learning models.
+
+    The serialized payload excludes every :class:`~squlearn.util.executor.Executor`
+    instance.  When loading, an executor has to be supplied explicitly and is
+    reinserted into all positions that previously held an executor reference.
+    """
+
+    def dump(self, target: Union[str, os.PathLike, IOBase]) -> None:
+        """Serialize the model to ``target``.
+
+        Args:
+            target: A string file path or a writable binary stream.
+
+        Raises:
+            TypeError: If ``target`` is neither a string path nor a binary stream.
+        """
+        if not (_is_path(target) or _is_binary_stream(target)):
+            raise TypeError(
+                "target must be a string file path or a binary IOBase stream, "
+                f"got {type(target).__name__!r}."
+            )
+
+        if _is_path(target):
+            with open(target, "wb") as file_handle:
+                _ExecutorPickler(file_handle).dump(self)
+        else:
+            _ExecutorPickler(target).dump(self)
+
+    @classmethod
+    def load(
+        cls,
+        source: Union[str, os.PathLike, IOBase],
+        executor: Executor,
+    ):
+        """Restore a model from ``source`` reinserting the supplied ``executor``.
+
+        Args:
+            source: A string file path or a readable binary stream.
+            executor: The :class:`~squlearn.util.executor.Executor` instance to use
+                for the restored model.
+
+        Returns:
+            The restored model instance.
+
+        Raises:
+            TypeError: If ``source`` is neither a string path nor a binary stream.
+            TypeError: If ``executor`` is not an :class:`~squlearn.util.executor.Executor`.
+        """
+        if not (_is_path(source) or _is_binary_stream(source)):
+            raise TypeError(
+                "source must be a string file path or a binary IOBase stream, "
+                f"got {type(source).__name__!r}."
+            )
+        if not isinstance(executor, Executor):
+            raise TypeError(
+                "executor must be an Executor instance, "
+                f"got {type(executor).__name__!r}."
+            )
+
+        if _is_path(source):
+            with open(source, "rb") as file_handle:
+                return _ExecutorUnpickler(file_handle, executor).load()
+        return _ExecutorUnpickler(source, executor).load()
