index 0000000..45589f8
--- /dev/null
+++ b/src/squlearn/qnn/loss/cross_entropy_loss.py
@@ -0,0 +1,86 @@
+"""Cross-entropy loss for QNN classifiers."""
+
+import numpy as np
+
+from .qnn_loss_base import QNNLossBase
+
+
+class CrossEntropyLoss(QNNLossBase):
+    """Cross-entropy loss for probability-valued QNN outputs.
+
+    Args:
+        eps (float): Clipping value used to avoid ``log(0)`` and division by zero.
+    """
+
+    def __init__(self, eps=1e-8):
+        super().__init__()
+        self.eps = eps
+
+    def value(self, value_dict, **kwargs) -> float:
+        """Compute the cross-entropy loss.
+
+        Args:
+            value_dict: Dictionary containing the model output under ``"f"``.
+            **kwargs: Must contain ``ground_truth``.
+
+        Returns:
+            float: Mean cross-entropy loss.
+        """
+        ground_truth = np.asarray(kwargs["ground_truth"])
+        f = np.clip(np.asarray(value_dict["f"]), self.eps, 1.0 - self.eps)
+
+        if f.ndim == 1 or ground_truth.ndim == 1:
+            ground_truth = np.ravel(ground_truth)
+            f = np.ravel(f)
+            return float(
+                -np.mean(ground_truth * np.log(f) + (1.0 - ground_truth) * np.log(1.0 - f))
+            )
+
+        return float(-np.mean(np.sum(ground_truth * np.log(f), axis=1)))
+
+    def gradient(self, value_dict, **kwargs) -> np.ndarray:
+        """Compute the parameter gradient of the cross-entropy loss.
+
+        Args:
+            value_dict: Dictionary containing ``"f"`` and model-output derivatives.
+            **kwargs: Must contain ``ground_truth``. The optional ``multiple_output``
+                argument can be used to indicate multiple-output training.
+
+        Returns:
+            np.ndarray: Gradient with respect to the optimized parameters.
+        """
+        ground_truth = np.asarray(kwargs["ground_truth"])
+        multiple_output = kwargs.get("multiple_output", False)
+
+        f = np.clip(np.asarray(value_dict["f"]), self.eps, 1.0 - self.eps)
+        if f.ndim == 1 or ground_truth.ndim == 1 or not multiple_output:
+            prefactor = (f - ground_truth) / (f * (1.0 - f))
+            prefactor = np.ravel(prefactor)
+        else:
+            prefactor = -ground_truth / f
+
+        gradients = []
+
+        if "dfdp" in value_dict:
+            dfdp = np.asarray(value_dict["dfdp"])
+            gradients.append(self._contract_derivative(prefactor, dfdp))
+
+        if self.opt_param_op and "dfdop" in value_dict:
+            dfdop = np.asarray(value_dict["dfdop"])
+            gradients.append(self._contract_derivative(prefactor, dfdop))
+
+        if not gradients:
+            return np.array([])
+
+        return np.concatenate([np.ravel(grad) for grad in gradients])
+
+    @staticmethod
+    def _contract_derivative(prefactor, derivative):
+        """Contract output derivatives with the cross-entropy output gradient."""
+        prefactor = np.asarray(prefactor)
+        derivative = np.asarray(derivative)
+
+        if prefactor.ndim == 1:
+            return np.mean(derivative * prefactor[:, np.newaxis], axis=0)
+
+        return np.mean(np.sum(derivative * prefactor[..., np.newaxis], axis=1), axis=0)
