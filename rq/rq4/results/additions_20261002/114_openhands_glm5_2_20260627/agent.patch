+"""Cross-Entropy Loss for QNNs."""
+
+from typing import Union
+
+import numpy as np
+
+from .qnn_loss_base import QNNLossBase
+
+
+class CrossEntropyLoss(QNNLossBase):
+    r"""Cross-entropy loss for classification.
+
+    The cross-entropy loss is computed from probability-valued model outputs
+    :math:`f`. For a single (binary) output it is evaluated as
+
+    .. math::
+        L = -\sum_i w_i \left[ y_i \log(f_i) + (1-y_i) \log(1-f_i) \right],
+
+    and for multiple outputs (multi-class) as
+
+    .. math::
+        L = -\sum_i \sum_c w_i \, y_{i,c} \log(f_{i,c}).
+
+    The model outputs are clipped to :math:`[\varepsilon, 1-\varepsilon]` in order
+    to avoid numerical instabilities from logarithms of zero.
+
+    Args:
+        eps (float): Small constant used for clipping the model outputs away from
+            zero and one (default: ``1e-8``).
+    """
+
+    def __init__(self, eps: float = 1e-8):
+        super().__init__()
+        self._eps = eps
+
+    @property
+    def loss_variance_available(self) -> bool:
+        """Returns False since the cross-entropy loss has no variance function."""
+        return False
+
+    @property
+    def loss_args_tuple(self) -> tuple:
+        """Returns evaluation tuple for the cross-entropy loss calculation."""
+        return ("f",)
+
+    @property
+    def variance_args_tuple(self) -> tuple:
+        """Returns evaluation tuple for the cross-entropy loss variance calculation."""
+        return tuple()
+
+    @property
+    def gradient_args_tuple(self) -> tuple:
+        """Returns evaluation tuple for the cross-entropy loss gradient calculation."""
+        if self._opt_param_op:
+            return ("f", "dfdp", "dfdop")
+        return ("f", "dfdp")
+
+    def value(self, value_dict: dict, **kwargs) -> float:
+        r"""Calculates the cross-entropy loss.
+
+        Args:
+            value_dict (dict): Contains calculated values of the model
+            ground_truth (np.ndarray): The true values :math:`y_i`
+            weights (np.ndarray): Weight for each data point, if None all data points
+                count the same
+
+        Returns:
+            Loss value
+        """
+        if "ground_truth" not in kwargs:
+            raise AttributeError("CrossEntropyLoss requires ground_truth.")
+        ground_truth = kwargs["ground_truth"]
+        if "weights" in kwargs and kwargs["weights"] is not None:
+            weights = kwargs["weights"]
+        else:
+            weights = np.ones_like(ground_truth)
+
+        f = np.clip(value_dict["f"], self._eps, 1.0 - self._eps)
+
+        if f.ndim > 1:
+            loss = -np.sum(
+                np.multiply(np.multiply(ground_truth, np.log(f)), weights)
+            )
+        else:
+            loss = -np.sum(
+                np.multiply(
+                    ground_truth * np.log(f)
+                    + (1.0 - ground_truth) * np.log(1.0 - f),
+                    weights,
+                )
+            )
+        return loss
+
+    def gradient(
+        self, value_dict: dict, **kwargs
+    ) -> Union[np.ndarray, tuple[np.ndarray, np.ndarray]]:
+        r"""Returns the gradient of the cross-entropy loss.
+
+        Args:
+            value_dict (dict): Contains calculated values of the model
+            ground_truth (np.ndarray): The true values :math:`y_i`
+            weights (np.ndarray): Weight for each data point, if None all data points
+                count the same
+            multiple_output (bool): True if the QNN has multiple outputs
+
+        Returns:
+            Gradient values
+        """
+        if "ground_truth" not in kwargs:
+            raise AttributeError("CrossEntropyLoss requires ground_truth.")
+
+        ground_truth = kwargs["ground_truth"]
+        if "weights" in kwargs and kwargs["weights"] is not None:
+            weights = kwargs["weights"]
+        else:
+            weights = np.ones_like(ground_truth)
+        multiple_output = "multiple_output" in kwargs and kwargs["multiple_output"]
+
+        f = np.clip(value_dict["f"], self._eps, 1.0 - self._eps)
+
+        if multiple_output:
+            d_loss_df = -np.multiply(
+                np.divide(ground_truth, f), weights
+            )
+        else:
+            d_loss_df = -np.multiply(
+                np.divide(ground_truth, f)
+                - np.divide(1.0 - ground_truth, 1.0 - f),
+                weights,
+            )
+
+        if value_dict["dfdp"].shape[0] == 0:
+            d_p = np.array([])
+        else:
+            if multiple_output:
+                d_p = np.einsum("ij,ijk->k", d_loss_df, value_dict["dfdp"])
+            else:
+                d_p = np.einsum("j,jk->k", d_loss_df, value_dict["dfdp"])
+
+        # Extra code for the cost operator derivatives
+        if not self._opt_param_op:
+            return d_p
+
+        if value_dict["dfdop"].shape[0] == 0:
+            d_op = np.array([])
+        else:
+            if multiple_output:
+                d_op = np.einsum("ij,ijk->k", d_loss_df, value_dict["dfdop"])
+            else:
+                d_op = np.einsum("j,jk->k", d_loss_df, value_dict["dfdop"])
+        return d_p, d_op
