+"""Cross-entropy loss for QNN classifiers."""
+
+from typing import Union
+
+import numpy as np
+
+from .qnn_loss_base import QNNLossBase
+
+
+class CrossEntropyLoss(QNNLossBase):
+    """Cross-entropy loss for probability-valued QNN classifier outputs.
+
+    The loss supports binary outputs with shape ``(n_samples,)`` and multiple-output
+    targets with shape ``(n_samples, n_outputs)``. Model probabilities are clipped to
+    ``[eps, 1 - eps]`` for numerical stability.
+    """
+
+    def __init__(self, eps: float = 1e-8) -> None:
+        super().__init__()
+        self.eps = eps
+
+    @property
+    def loss_args_tuple(self) -> tuple:
+        """Returns evaluation tuple for the cross-entropy loss calculation."""
+        return ("f",)
+
+    @property
+    def gradient_args_tuple(self) -> tuple:
+        """Returns evaluation tuple for the cross-entropy loss gradient calculation."""
+        if self._opt_param_op:
+            return ("f", "dfdp", "dfdop")
+        return ("f", "dfdp")
+
+    def value(self, value_dict: dict, **kwargs) -> float:
+        """Calculates the binary or multiple-output cross-entropy loss."""
+        if "ground_truth" not in kwargs:
+            raise AttributeError("CrossEntropyLoss requires ground_truth.")
+
+        ground_truth = np.asarray(kwargs["ground_truth"])
+        probabilities = np.clip(np.asarray(value_dict["f"]), self.eps, 1.0 - self.eps)
+        if "weights" in kwargs and kwargs["weights"] is not None:
+            weights = np.asarray(kwargs["weights"])
+        else:
+            weights = np.ones_like(ground_truth, dtype=float)
+
+        return float(
+            -np.sum(
+                weights
+                * (
+                    ground_truth * np.log(probabilities)
+                    + (1.0 - ground_truth) * np.log(1.0 - probabilities)
+                )
+            )
+        )
+
+    def gradient(
+        self, value_dict: dict, **kwargs
+    ) -> Union[np.ndarray, tuple[np.ndarray, np.ndarray]]:
+        """Returns gradients from supplied QNN output derivatives."""
+        if "ground_truth" not in kwargs:
+            raise AttributeError("CrossEntropyLoss requires ground_truth.")
+
+        ground_truth = np.asarray(kwargs["ground_truth"])
+        probabilities = np.clip(np.asarray(value_dict["f"]), self.eps, 1.0 - self.eps)
+        if "weights" in kwargs and kwargs["weights"] is not None:
+            weights = np.asarray(kwargs["weights"])
+        else:
+            weights = np.ones_like(ground_truth, dtype=float)
+        multiple_output = "multiple_output" in kwargs and kwargs["multiple_output"]
+
+        prefactor = weights * (probabilities - ground_truth) / (
+            probabilities * (1.0 - probabilities)
+        )
+
+        if value_dict["dfdp"].shape[0] == 0:
+            d_p = np.array([])
+        else:
+            if multiple_output:
+                d_p = np.einsum("ij,ijk->k", prefactor, value_dict["dfdp"])
+            else:
+                d_p = np.einsum("j,jk->k", prefactor, value_dict["dfdp"])
+
+        if not self._opt_param_op:
+            return d_p
+
+        if value_dict["dfdop"].shape[0] == 0:
+            d_op = np.array([])
+        else:
+            if multiple_output:
+                d_op = np.einsum("ij,ijk->k", prefactor, value_dict["dfdop"])
+            else:
+                d_op = np.einsum("j,jk->k", prefactor, value_dict["dfdop"])
+        return d_p, d_op
