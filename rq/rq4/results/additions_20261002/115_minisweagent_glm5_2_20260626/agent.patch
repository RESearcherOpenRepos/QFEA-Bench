+    def _repeat_mixer_gate_maps(self, n_repetitions: int) -> List[List]:
+        """
+        Repeat the user-supplied mixer gate maps for ``n_repetitions``
+        layers, assigning consistent ``pauli_label``s so that the angles can
+        be looked up from the variational parameters.
+
+        The single-qubit and two-qubit terms are kept separated and ordered
+        consistently with ``mixer_1q_coeffs`` and ``mixer_2q_coeffs``.
+        """
+        output_gate_list = []
+
+        for each_repetition in range(n_repetitions):
+            layer_gates = []
+
+            # Single-qubit mixer terms
+            for gate_index, gate_map in enumerate(self._mixer_1q_gate_maps):
+                new_gate = self._clone_gate_map(
+                    gate_map, ['mixer', each_repetition, gate_index])
+                layer_gates.append(new_gate)
+
+            # Two-qubit mixer terms
+            for gate_index, gate_map in enumerate(self._mixer_2q_gate_maps):
+                new_gate = self._clone_gate_map(
+                    gate_map, ['mixer', each_repetition, gate_index])
+                layer_gates.append(new_gate)
+
+            output_gate_list.append(layer_gates)
+
+        return output_gate_list
+
+    @staticmethod
+    def _clone_gate_map(gate_map, pauli_label):
+        """
+        Create a copy of ``gate_map`` with an updated ``pauli_label`` so that
+        the gate can be uniquely identified within the abstract circuit.
+        """
+        new_gate = copy.copy(gate_map)
+        new_gate.pauli_label = pauli_label
+        return new_gate
+
 
