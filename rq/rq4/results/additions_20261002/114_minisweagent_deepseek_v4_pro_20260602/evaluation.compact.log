    def gradient(
        self, value_dict: dict, **kwargs
    ) -> Union[np.ndarray, tuple[np.ndarray, np.ndarray]]:
        r"""Returns the gradient of the cross-entropy loss.
    
        This function calculates the gradient of the cross-entropy loss with respect
        to the model parameters.
    
        Args:
            value_dict (dict): Contains calculated values of the model.
                Must contain keys ``"f"``, ``"dfdp"``, and optionally ``"dfdop"``.
            ground_truth (np.ndarray): The true labels.
            weights (np.ndarray, optional): Weight for each data point.
                If None, all data points count the same.
            multiple_output (bool): True if the QNN has multiple outputs.
    
        Returns:
            Gradient values as a single array or tuple of arrays.
        """
        if "ground_truth" not in kwargs:
            raise AttributeError("CrossEntropyLoss requires ground_truth.")
    
        ground_truth = kwargs["ground_truth"]
        if "weights" in kwargs and kwargs["weights"] is not None:
            weights = kwargs["weights"]
        else:
            weights = np.ones_like(ground_truth)
    
        multiple_output = "multiple_output" in kwargs and kwargs["multiple_output"]
    
        f = value_dict["f"]
        f_clipped = np.clip(f, self._eps, 1.0 - self._eps)
    
        if ground_truth.ndim == 1 or ground_truth.shape[1] == 1:
            # Binary cross-entropy gradient
            gt = ground_truth.ravel()
            f_clipped = f_clipped.ravel()
            w = weights.ravel()
    
            # dL/df = -(gt/f - (1-gt)/(1-f))
            dL_df = -(gt / f_clipped - (1.0 - gt) / (1.0 - f_clipped))
            dL_df = dL_df * w
        else:
            # Multiple-output cross-entropy gradient
            # dL/df_c = -gt_c / f_c
            dL_df = -weights * ground_truth / f_clipped
    
        # Compute gradient with respect to circuit parameters
