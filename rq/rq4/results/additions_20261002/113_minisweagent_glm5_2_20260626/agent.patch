+++ b/src/squlearn/kernel/matrix/kernel_optimizer.py
@@ -0,0 +1,357 @@
+"""Quantum kernel optimizer."""
+
+import numpy as np
+from functools import partial
+from typing import Optional, Sequence, Union
+
+from .kernel_matrix_base import KernelMatrixBase
+from ..loss.kernel_loss_base import KernelLossBase
+from ...optimizers.optimizer_base import OptimizerBase
+
+
+class KernelOptimizer(KernelMatrixBase):
+    """
+    Quantum kernel optimizer.
+
+    This class wraps a quantum kernel together with a loss function and an
+    optimizer. It can be used wherever a quantum kernel is accepted by the
+    supported models (e.g. :class:`QGPR`, :class:`QKRR`, :class:`QSVR`,
+    :class:`QGPC`, and :class:`QSVC`). When a model is fitted, the wrapped
+    kernel parameters are optimized first and the optimal parameters are
+    assigned to the underlying quantum kernel.
+
+    Args:
+        quantum_kernel (KernelMatrixBase): The quantum kernel to be optimized
+            (either a fidelity quantum kernel (FQK) or projected quantum kernel (PQK)).
+        loss (Optional[KernelLossBase]): The loss function to be minimized. If
+            ``None``, a default :class:`~squlearn.kernel.loss.NLL` loss is used.
+        optimizer (Optional[OptimizerBase]): The optimizer to be used for
+            finding the minimum of the loss function.
+        initial_parameters (Optional[Sequence[float]]): Initial guess for the
+            encoding circuit's trainable parameters. If ``None``, the current
+            parameters of the quantum kernel are used.
+
+    **Example**
+
+    .. code-block::
+
+        from squlearn import Executor
+        from squlearn.encoding_circuit import HubregtsenEncodingCircuit
+        from squlearn.kernel.matrix import FidelityKernel, KernelOptimizer
+        from squlearn.kernel.loss import NLL
+        from squlearn.optimizers import SLSQP
+        from squlearn.kernel.ml import QGPR
+
+        enc_circ = HubregtsenEncodingCircuit(num_qubits=2, num_features=2, num_layers=2)
+        q_kernel = FidelityKernel(encoding_circuit=enc_circ, executor=Executor())
+        optimizer = KernelOptimizer(
+            quantum_kernel=q_kernel,
+            loss=NLL(sigma=1e-2),
+            optimizer=SLSQP(),
+            initial_parameters=np.random.rand(enc_circ.num_parameters),
+        )
+        qgpr = QGPR(quantum_kernel=optimizer)
+        qgpr.fit(X_train, y_train)
+        optimal_parameters = optimizer.get_optimal_parameters()
+    """
+
+    def __init__(
+        self,
+        quantum_kernel: KernelMatrixBase,
+        loss: Optional[KernelLossBase] = None,
+        optimizer: Optional[OptimizerBase] = None,
+        initial_parameters: Optional[Sequence[float]] = None,
+    ) -> None:
+        if not isinstance(quantum_kernel, KernelMatrixBase):
+            raise TypeError(
+                "quantum_kernel must be an instance of KernelMatrixBase, "
+                f"got {type(quantum_kernel)} instead."
+            )
+
+        self._quantum_kernel = quantum_kernel
+        self._loss = loss
+        self._optimizer = optimizer
+        self._initial_parameters = initial_parameters
+
+        self._opt_result = None
+        self._optimizer_evals = None
+        self._optimal_value = None
+        self._optimal_point = None
+        self._optimal_parameters = None
+        self._fitted = False
+
+        # Bind the quantum kernel to the loss if a loss is provided
+        if self._loss is not None:
+            self._loss.quantum_kernel = self._quantum_kernel
+
+    # ------------------------------------------------------------------
+    # Optimization
+    # ------------------------------------------------------------------
+    def run_optimization(self, X: np.ndarray, y: np.ndarray = None):
+        """Run the kernel parameter optimization.
+
+        Args:
+            X (np.ndarray): The input data.
+            y (np.ndarray): The labels.
+
+        Returns:
+            OptimizeResult: The optimization result.
+        """
+        if self._loss is None:
+            raise ValueError(
+                "No loss function is set for the KernelOptimizer. "
+                "Please provide a loss function."
+            )
+        if self._optimizer is None:
+            raise ValueError(
+                "No optimizer is set for the KernelOptimizer. "
+                "Please provide an optimizer."
+            )
+
+        num_params = self._quantum_kernel.num_parameters
+        if num_params == 0:
+            raise ValueError(
+                "Quantum kernel cannot be fit because there are no training "
+                "parameters specified."
+            )
+
+        if self._initial_parameters is None:
+            self._initial_parameters = self._quantum_kernel.parameters
+
+        # Bind the quantum kernel to the loss (in case it was changed)
+        self._loss.quantum_kernel = self._quantum_kernel
+
+        # Perform kernel optimization
+        loss_function = partial(self._loss.compute, data=X, labels=y)
+        opt_result = self._optimizer.minimize(
+            fun=loss_function, x0=np.array(self._initial_parameters, dtype=float)
+        )
+
+        self._opt_result = opt_result
+        self._optimal_value = opt_result.fun
+        self._optimal_point = opt_result.x
+        self._optimal_parameters = np.array(opt_result.x)
+        self._fitted = True
+
+        # Assign the optimal parameters to the underlying quantum kernel
+        self._quantum_kernel.assign_parameters(self._optimal_parameters)
+
+        return self._opt_result
+
+    def fit_kernel(self, X: np.ndarray, y: np.ndarray = None):
+        """Fit (optimize) the wrapped quantum kernel parameters.
+
+        This is a convenience alias for :meth:`run_optimization`.
+
+        Args:
+            X (np.ndarray): The input data.
+            y (np.ndarray): The labels.
+        """
+        self.run_optimization(X, y)
+
+    def get_optimal_parameters(self) -> np.ndarray:
+        """Returns the optimized kernel parameters after fitting.
+
+        Returns:
+            numpy.ndarray: The optimal parameter values.
+        """
+        if self._optimal_parameters is None:
+            raise ValueError(
+                "The kernel optimizer has not been fitted yet. "
+                "Please call run_optimization or fit a model first."
+            )
+        return self._optimal_parameters
+
+    @property
+    def optimal_value(self):
+        """Returns the optimal value of the loss function."""
+        return self._optimal_value
+
+    @property
+    def optimal_point(self):
+        """Returns the optimal point of the loss function."""
+        return self._optimal_point
+
+    @property
+    def opt_result(self):
+        """Returns the full optimization result."""
+        return self._opt_result
+
+    @property
+    def loss(self) -> Optional[KernelLossBase]:
+        """Returns the loss function used for optimization."""
+        return self._loss
+
+    @loss.setter
+    def loss(self, loss: KernelLossBase) -> None:
+        self._loss = loss
+        if loss is not None:
+            loss.quantum_kernel = self._quantum_kernel
+
+    @property
+    def optimizer(self) -> Optional[OptimizerBase]:
+        """Returns the optimizer used for optimization."""
+        return self._optimizer
+
+    @optimizer.setter
+    def optimizer(self, optimizer: OptimizerBase) -> None:
+        self._optimizer = optimizer
+
+    @property
+    def initial_parameters(self) -> Optional[Sequence[float]]:
+        """Returns the initial parameters for the optimization."""
+        return self._initial_parameters
+
+    @initial_parameters.setter
+    def initial_parameters(self, initial_parameters: Sequence[float]) -> None:
+        self._initial_parameters = initial_parameters
+
+    # ------------------------------------------------------------------
+    # Delegation to the wrapped quantum kernel
+    # ------------------------------------------------------------------
+    @property
+    def quantum_kernel(self) -> KernelMatrixBase:
+        """Returns the wrapped quantum kernel."""
+        return self._quantum_kernel
+
+    @property
+    def encoding_circuit(self):
+        """Returns the encoding circuit of the wrapped quantum kernel."""
+        return self._quantum_kernel.encoding_circuit
+
+    @property
+    def num_qubits(self) -> int:
+        """Returns the number of qubits of the wrapped quantum kernel."""
+        return self._quantum_kernel.num_qubits
+
+    @property
+    def num_features(self) -> int:
+        """Returns the feature dimension of the wrapped quantum kernel."""
+        return self._quantum_kernel.num_features
+
+    @property
+    def parameters(self) -> np.ndarray:
+        """Returns the trainable parameters of the wrapped quantum kernel."""
+        return self._quantum_kernel.parameters
+
+    @property
+    def num_parameters(self) -> int:
+        """Returns the number of trainable parameters of the wrapped quantum kernel."""
+        return self._quantum_kernel.num_parameters
+
+    @property
+    def parameter_bounds(self) -> np.ndarray:
+        """Returns the bounds of the trainable parameters of the wrapped quantum kernel."""
+        return self._quantum_kernel.parameter_bounds
+
+    @property
+    def feature_bounds(self) -> np.ndarray:
+        """Returns the bounds of the features of the wrapped quantum kernel."""
+        return self._quantum_kernel.feature_bounds
+
+    def evaluate(self, x: np.ndarray, y: np.ndarray = None) -> np.ndarray:
+        """Evaluates the wrapped quantum kernel matrix.
+
+        Args:
+            x (np.ndarray): Vector of training or test data.
+            y (np.ndarray, default=None): Vector of training or test data.
+
+        Returns:
+            np.ndarray: The quantum kernel matrix.
+        """
+        return self._quantum_kernel.evaluate(x, y)
+
+    def evaluate_pairwise(self, x: np.ndarray, y: np.ndarray = None) -> float:
+        """Evaluates the wrapped quantum kernel pairwise."""
+        return self._quantum_kernel.evaluate_pairwise(x, y)
+
+    def assign_parameters(self, parameters):
+        """Assigns parameters to the wrapped quantum kernel.
+
+        Args:
+            parameters (np.ndarray): Array containing numerical values to be
+                assigned to the trainable parameters.
+        """
+        self._quantum_kernel.assign_parameters(parameters)
+
+    def evaluate_with_parameters(
+        self, x: np.ndarray, y: np.ndarray, parameters: np.ndarray
+    ) -> np.ndarray:
+        """Evaluates the wrapped quantum kernel with assigned parameters."""
+        return self._quantum_kernel.evaluate_with_parameters(x, y, parameters)
+
+    def is_stationary(self) -> bool:
+        """Returns whether the wrapped quantum kernel is stationary."""
+        return self._quantum_kernel.is_stationary()
+
+    @property
+    def _regularization(self):
+        """Returns the regularization setting of the wrapped quantum kernel."""
+        return self._quantum_kernel._regularization
+
+    @_regularization.setter
+    def _regularization(self, value):
+        self._quantum_kernel._regularization = value
+
+    def _regularize_matrix(self, matrix: np.ndarray) -> np.ndarray:
+        """Regularizes the kernel matrix using the wrapped quantum kernel."""
+        return self._quantum_kernel._regularize_matrix(matrix)
+
+    def get_params(self, deep: bool = True) -> dict:
+        """Returns hyper-parameters and their values.
+
+        Args:
+            deep (bool): If True, also the parameters for contained objects
+                are returned (default=True).
+
+        Returns:
+            Dictionary with hyper-parameters and values.
+        """
+        params = {
+            "quantum_kernel": self._quantum_kernel,
+            "loss": self._loss,
+            "optimizer": self._optimizer,
+            "initial_parameters": self._initial_parameters,
+        }
+        if deep and isinstance(self._quantum_kernel, KernelMatrixBase):
+            params.update(self._quantum_kernel.get_params(deep=deep))
+        return params
+
+    def set_params(self, **params) -> None:
+        """Sets the value of the kernel optimizer hyper-parameters.
+
+        Args:
+            params: Hyper-parameters and their values, e.g. ``num_qubits=2``.
+        """
+        valid_params = self.get_params()
+        for key in params.keys():
+            if key not in valid_params:
+                raise ValueError(
+                    f"Invalid parameter {key!r}. "
+                    f"Valid parameters are {sorted(valid_params)!r}."
+                )
+
+        self_params = self.get_params(deep=False).keys() & params.keys()
+        for key in self_params:
+            if key == "quantum_kernel":
+                self._quantum_kernel = params[key]
+                if self._loss is not None:
+                    self._loss.quantum_kernel = self._quantum_kernel
+            elif key == "loss":
+                self._loss = params[key]
+                if self._loss is not None:
+                    self._loss.quantum_kernel = self._quantum_kernel
+            elif key == "optimizer":
+                self._optimizer = params[key]
+            elif key == "initial_parameters":
+                self._initial_parameters = params[key]
+
+        if isinstance(self._quantum_kernel, KernelMatrixBase):
+            quantum_kernel_params = (
+                self._quantum_kernel.get_params().keys() & params.keys()
+            )
+            if quantum_kernel_params:
+                self._quantum_kernel.set_params(
+                    **{key: params[key] for key in quantum_kernel_params}
+                )
+        return self
