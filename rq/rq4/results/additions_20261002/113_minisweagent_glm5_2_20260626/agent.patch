+"""Base class for kernel loss functions."""
+
+from ..matrix.kernel_matrix_base import KernelMatrixBase
+
+
+class KernelLossBase:
+    """
+    Base class for a kernel loss function.
+
+    A kernel loss function evaluates a scalar loss for a quantum kernel
+    :math:`K_{\\theta}` parameterized by variational parameters
+    :math:`\\theta`. The quantum kernel is bound to the loss either through the
+    constructor of a concrete loss or via :class:`KernelOptimizer` before the
+    optimization is started.
+
+    Args:
+        quantum_kernel (KernelMatrixBase): The quantum kernel to be used
+            (either a fidelity quantum kernel (FQK) or projected quantum kernel (PQK)).
+    """
+
+    def __init__(self, quantum_kernel: KernelMatrixBase = None) -> None:
+        self._quantum_kernel = quantum_kernel
+
+    @property
+    def quantum_kernel(self) -> KernelMatrixBase:
+        """Returns the quantum kernel associated with the loss."""
+        return self._quantum_kernel
+
+    @quantum_kernel.setter
+    def quantum_kernel(self, quantum_kernel: KernelMatrixBase) -> None:
+        """Sets the quantum kernel associated with the loss."""
+        self._quantum_kernel = quantum_kernel
+
+    def compute(self, parameter_values, data, labels):
+        """Compute the kernel loss function.
+
+        Args:
+            parameter_values (Sequence[float]): The parameter values for the
+                variational quantum kernel parameters.
+            data (np.ndarray): The training data to be used for the kernel matrix.
+            labels (np.ndarray): The training labels.
+
+        Returns:
+            float: The evaluated kernel loss.
+        """
+        raise NotImplementedError
