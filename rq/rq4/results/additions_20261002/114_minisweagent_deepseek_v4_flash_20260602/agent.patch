+"""Cross-Entropy Loss for QNNs."""
+
+from typing import Union
+
+import numpy as np
+
+from .qnn_loss_base import QNNLossBase
+
+
+class CrossEntropyLoss(QNNLossBase):
+    r"""Cross-entropy loss for classification.
+
+    Computes the cross-entropy between the model output (interpreted as probabilities)
+    and the ground truth labels. Supports both binary and multi-class classification.
+
+    For binary classification (single output), the loss is:
+
+    .. math::
+        L = -\sum_i \left[ y_i \log(f_i) + (1-y_i) \log(1-f_i) \right]
+
+    For multi-class classification (multiple outputs), the loss is:
+
+    .. math::
+        L = -\sum_i \sum_j y_{ij} \log(f_{ij})
+
+    Args:
+        eps (float): Small constant for numerical stability in logarithms (default: 1e-8).
+    """
+
+    def __init__(self, eps: float = 1e-8):
+        super().__init__()
+        self._eps = eps
+
+    @property
+    def loss_variance_available(self) -> bool:
+        """Returns False since the variance of the cross-entropy loss is not implemented."""
+        return False
+
+    @property
+    def loss_args_tuple(self) -> tuple:
+        """Returns evaluation tuple for loss calculation."""
+        return ("f",)
+
+    @property
+    def variance_args_tuple(self) -> tuple:
+        """Returns evaluation tuple for variance calculation."""
+        raise NotImplementedError()
+
+    @property
+    def gradient_args_tuple(self) -> tuple:
+        """Returns evaluation tuple for loss gradient calculation."""
+        if self._opt_param_op:
+            return ("f", "dfdp", "dfdop")
+        return ("f", "dfdp")
+
+    def value(self, value_dict: dict, **kwargs) -> float:
+        r"""Calculates the cross-entropy loss.
+
+        Args:
+            value_dict (dict): Contains calculated values of the model.
+                Must contain key ``"f"`` with the model output.
+            ground_truth (np.ndarray): The true labels.
+                For binary classification: shape (n_samples,) with values in {0, 1}.
+                For multi-class: shape (n_samples, n_classes) with one-hot encoding.
+            multiple_output (bool): If True, use multi-class cross-entropy.
+            weights (np.ndarray, optional): Weight for each data point.
+
+        Returns:
+            float: The cross-entropy loss value.
+        """
+        if "ground_truth" not in kwargs:
+            raise AttributeError("CrossEntropyLoss requires ground_truth.")
+
+        ground_truth = kwargs["ground_truth"]
+        multiple_output = kwargs.get("multiple_output", False)
+
+        if "weights" in kwargs and kwargs["weights"] is not None:
+            weights = kwargs["weights"]
+        else:
+            weights = np.ones_like(ground_truth if not multiple_output else ground_truth[:, 0])
+
+        f = value_dict["f"]
+        eps = self._eps
+
+        if multiple_output:
+            # Multi-class cross-entropy
+            f = np.clip(f, eps, 1.0)
+            # Normalize to ensure probabilities sum to 1
+            f = f / np.sum(f, axis=-1, keepdims=True)
+            loss_vals = -np.sum(ground_truth * np.log(f), axis=-1)
+            return np.sum(loss_vals * weights)
+        else:
+            # Binary cross-entropy
+            f = np.clip(f, eps, 1.0 - eps)
+            loss_vals = -ground_truth * np.log(f) - (1.0 - ground_truth) * np.log(1.0 - f)
+            return np.sum(loss_vals * weights)
+
+    def gradient(
+        self, value_dict: dict, **kwargs
+    ) -> Union[np.ndarray, tuple[np.ndarray, np.ndarray]]:
+        r"""Returns the gradient of the cross-entropy loss.
+
+        Args:
+            value_dict (dict): Contains calculated values of the model.
+                Must contain keys ``"f"``, ``"dfdp"``, and optionally ``"dfdop"``.
+            ground_truth (np.ndarray): The true labels.
+            multiple_output (bool): If True, use multi-class cross-entropy.
+            weights (np.ndarray, optional): Weight for each data point.
+
+        Returns:
+            Union[np.ndarray, tuple[np.ndarray, np.ndarray]]: Gradient values.
+                If ``opt_param_op`` is True, returns a tuple (d_p, d_op).
+                Otherwise, returns d_p only.
+        """
+        if "ground_truth" not in kwargs:
+            raise AttributeError("CrossEntropyLoss requires ground_truth.")
+
+        ground_truth = kwargs["ground_truth"]
+        multiple_output = kwargs.get("multiple_output", False)
+
+        if "weights" in kwargs and kwargs["weights"] is not None:
+            weights = kwargs["weights"]
+        else:
+            weights = np.ones_like(ground_truth if not multiple_output else ground_truth[:, 0])
+
+        f = value_dict["f"]
+        eps = self._eps
+
+        if multiple_output:
+            # Multi-class cross-entropy gradient
+            f = np.clip(f, eps, 1.0)
+            f = f / np.sum(f, axis=-1, keepdims=True)
+            # dL/df_i = -y_i / f_i
+            grad_factor = -ground_truth / f
+            # Apply weights
+            if weights.ndim == 1:
+                grad_factor = grad_factor * weights[:, np.newaxis]
+            else:
+                grad_factor = grad_factor * weights
+        else:
+            # Binary cross-entropy gradient
+            f = np.clip(f, eps, 1.0 - eps)
+            # dL/df = (f - y) / (f * (1 - f))
+            grad_factor = (f - ground_truth) / (f * (1.0 - f))
+            # Apply weights
+            grad_factor = grad_factor * weights
+
+        # Compute gradient w.r.t. PQC parameters
+        if value_dict["dfdp"].shape[0] == 0:
+            d_p = np.array([])
+        else:
+            if multiple_output:
+                # dfdp shape: (n_samples, n_outputs, n_params)
+                # grad_factor shape: (n_samples, n_outputs)
+                d_p = np.einsum("ij,ijk->k", grad_factor, value_dict["dfdp"])
+            else:
+                # dfdp shape: (n_samples, n_params)
+                # grad_factor shape: (n_samples,)
+                d_p = np.einsum("j,jk->k", grad_factor, value_dict["dfdp"])
+
+        if not self._opt_param_op:
+            return d_p
+
+        # Compute gradient w.r.t. observable parameters
+        if value_dict["dfdop"].shape[0] == 0:
+            d_op = np.array([])
+        else:
+            if multiple_output:
+                d_op = np.einsum("ij,ijk->k", grad_factor, value_dict["dfdop"])
+            else:
+                d_op = np.einsum("j,jk->k", grad_factor, value_dict["dfdop"])
+
+        return d_p, d_op
