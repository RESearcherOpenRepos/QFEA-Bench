@@ -0,0 +1,219 @@
+"""Serialization mixin for quantum machine learning models.
+
+This module provides the :class:`SerializableModelMixin` which supplies
+serialization capabilities to the supported model classes (quantum neural
+networks, kernel models and reservoir-computing models). The serialization
+excludes the live execution environment (i.e. the :class:`Executor` instances)
+from the payload and reinserts a supplied executor when the model is loaded.
+"""
+
+from __future__ import annotations
+
+import copy
+import io
+from typing import Any, Union
+
+import dill as pickle
+
+from ..executor import Executor
+
+
+class _ExecutorPlaceholder:
+    """Placeholder used to mark the position of an executor in a serialized payload.
+
+    Instances of this class are substituted for :class:`Executor` instances when a
+    model is dumped and are replaced by the supplied executor when the model is
+    loaded. The placeholder is a lightweight marker and does not carry any
+    execution state.
+    """
+
+    def __init__(self) -> None:
+        pass
+
+
+def _replace_executors(obj: Any, memo: dict) -> Any:
+    """Recursively replace :class:`Executor` instances with placeholders.
+
+    The ``memo`` dictionary maps the identity of already visited objects to their
+    (possibly replaced) counterparts. This preserves repeated and nested
+    references so that a single executor referenced multiple times is replaced by
+    a single placeholder.
+
+    Args:
+        obj: The object to traverse.
+        memo: Mapping from ``id(obj)`` to the processed object.
+
+    Returns:
+        The object with all executor references replaced by placeholders.
+    """
+    if isinstance(obj, Executor):
+        if id(obj) in memo:
+            return memo[id(obj)]
+        placeholder = _ExecutorPlaceholder()
+        memo[id(obj)] = placeholder
+        return placeholder
+
+    # Only traverse containers and objects that can hold references.
+    if isinstance(obj, dict):
+        if id(obj) in memo:
+            return memo[id(obj)]
+        new_dict = {}
+        memo[id(obj)] = new_dict
+        for key, value in obj.items():
+            new_dict[_replace_executors(key, memo)] = _replace_executors(value, memo)
+        return new_dict
+
+    if isinstance(obj, (list, tuple, set, frozenset)):
+        if id(obj) in memo:
+            return memo[id(obj)]
+        new_list = [_replace_executors(item, memo) for item in obj]
+        memo[id(obj)] = new_list
+        if isinstance(obj, tuple):
+            return tuple(new_list)
+        if isinstance(obj, set):
+            return set(new_list)
+        if isinstance(obj, frozenset):
+            return frozenset(new_list)
+        return new_list
+
+    # Handle arbitrary objects via their __dict__.
+    if hasattr(obj, "__dict__"):
+        if id(obj) in memo:
+            return memo[id(obj)]
+        memo[id(obj)] = obj
+        for key, value in list(vars(obj).items()):
+            try:
+                setattr(obj, key, _replace_executors(value, memo))
+            except (AttributeError, TypeError):
+                # Some attributes are read-only; leave them untouched.
+                pass
+        return obj
+
+    return obj
+
+
+def _restore_executors(obj: Any, executor: Executor, memo: dict) -> Any:
+    """Recursively replace :class:`_ExecutorPlaceholder` instances with the executor.
+
+    Args:
+        obj: The object to traverse.
+        executor: The executor to insert in place of placeholders.
+        memo: Mapping from ``id(obj)`` to the processed object.
+
+    Returns:
+        The object with all placeholders replaced by the supplied executor.
+    """
+    if isinstance(obj, _ExecutorPlaceholder):
+        memo[id(obj)] = executor
+        return executor
+
+    if isinstance(obj, dict):
+        if id(obj) in memo:
+            return memo[id(obj)]
+        new_dict = {}
+        memo[id(obj)] = new_dict
+        for key, value in obj.items():
+            new_dict[_restore_executors(key, executor, memo)] = _restore_executors(
+                value, executor, memo
+            )
+        return new_dict
+
+    if isinstance(obj, (list, tuple, set, frozenset)):
+        if id(obj) in memo:
+            return memo[id(obj)]
+        new_list = [_restore_executors(item, executor, memo) for item in obj]
+        memo[id(obj)] = new_list
+        if isinstance(obj, tuple):
+            return tuple(new_list)
+        if isinstance(obj, set):
+            return set(new_list)
+        if isinstance(obj, frozenset):
+            return frozenset(new_list)
+        return new_list
+
+    if hasattr(obj, "__dict__"):
+        if id(obj) in memo:
+            return memo[id(obj)]
+        memo[id(obj)] = obj
+        for key, value in list(vars(obj).items()):
+            try:
+                setattr(obj, key, _restore_executors(value, executor, memo))
+            except (AttributeError, TypeError):
+                pass
+        return obj
+
+    return obj
+
+
+class SerializableModelMixin:
+    """Mixin supplying serialization to the supported model classes.
+
+    The mixin provides :meth:`dump` and :meth:`load` methods that serialize a
+    model to a file path or a binary stream while excluding the live execution
+    environment (executor instances) from the payload. On loading, a supplied
+    executor is reinserted into all positions previously occupied by an executor.
+    """
+
+    def dump(self, target: Union[str, io.IOBase]) -> None:
+        """Serialize the model to a file path or a binary stream.
+
+        Executor references are removed from the payload before serialization.
+
+        Args:
+            target: A string file path or a binary (``IOBase``) stream to which
+                the serialized model is written.
+
+        Raises:
+            TypeError: If ``target`` is neither a string path nor a binary stream.
+        """
+        if isinstance(target, str):
+            with open(target, "wb") as file:
+                self._dump_to_stream(file)
+        elif isinstance(target, io.IOBase):
+            self._dump_to_stream(target)
+        else:
+            raise TypeError(
+                "target must be a string file path or a binary IOBase stream, "
+                f"got {type(target)!r}."
+            )
+
+    def _dump_to_stream(self, stream: io.IOBase) -> None:
+        """Serialize the model to an open binary stream with executors removed."""
+        # Work on a copy so that the original model is left untouched.
+        payload = copy.deepcopy(self)
+        payload = _replace_executors(payload, {})
+        pickle.dump(payload, stream)
+
+    @classmethod
+    def load(cls, source: Union[str, io.IOBase], executor: Executor):
+        """Restore a model from a file path or a binary stream.
+
+        All executor references are reinserted from the supplied ``executor``.
+
+        Args:
+            source: A string file path or a binary (``IOBase``) stream from which
+                the serialized model is read.
+            executor: The executor instance to reinsert into the restored model.
+
+        Returns:
+            The restored model instance.
+
+        Raises:
+            TypeError: If ``source`` is neither a string path nor a binary stream.
+        """
+        if isinstance(source, str):
+            with open(source, "rb") as file:
+                return cls._load_from_stream(file, executor)
+        elif isinstance(source, io.IOBase):
+            return cls._load_from_stream(source, executor)
+        else:
+            raise TypeError(
+                "source must be a string file path or a binary IOBase stream, "
+                f"got {type(source)!r}."
+            )
+
+    @classmethod
+    def _load_from_stream(cls, stream: io.IOBase, executor: Executor):
+        """Restore a model from an open binary stream and reinsert the executor."""
+        payload = pickle.load(stream)
+        return _restore_executors(payload, executor, {})
