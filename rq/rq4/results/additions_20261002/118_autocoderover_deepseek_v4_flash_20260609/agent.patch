+        # Check if pqc or operator are being updated
+        update_pqc = "pqc" in params
+        update_operator = "operator" in params
+        update_param_ini = "param_ini" in params
+        update_param_op_ini = "param_op_ini" in params
+        update_parameter_seed = "parameter_seed" in params
+
+        # Call parent set_params to update the attributes
+        super().set_params(**params)
