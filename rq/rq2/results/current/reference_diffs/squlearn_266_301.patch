+            variational_arrangement="HEA",
+            num_variational_layers=variational_layers,
+            block_depth=block_depth,
+        )
+        assert circuit.num_parameters == 3 * qubits * variational_layers
+
+        circuit = KyriienkoEncodingCircuit(
