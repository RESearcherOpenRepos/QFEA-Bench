{
  "model": "litellm-generic-openrouter/z-ai/glm-5.2",
  "prediction_model_name": "glm-5.2",
  "model_temperature": 0.0,
  "conv_round_limit": 5,
  "overall_retry_limit": 1,
  "timeout_seconds": 600,
  "env": {
    "OPENROUTER_API_KEY": "$OPENROUTER_API_KEY",
    "ACR_LITELLM_API_KEY": "$OPENROUTER_API_KEY",
    "ACR_LITELLM_API_BASE": "https://openrouter.ai/api/v1",
    "ACR_TOKEN_LIMIT": "16384",
    "ACR_LITELLM_TIMEOUT": "300",
    "ACR_LITELLM_ENABLE_SEARCH_TOOLS": "1",
    "ACR_LITELLM_EXTRA_BODY": "{\"usage\":{\"include\":true},\"reasoning\":{\"effort\":\"none\"},\"provider\":{\"only\":[\"Z.AI\"],\"allow_fallbacks\":false}}"
  }
}
