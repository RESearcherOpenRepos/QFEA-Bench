{
  "model": "litellm-generic-dashscope/glm-5.2",
  "prediction_model_name": "glm-5.2",
  "model_temperature": 0.0,
  "conv_round_limit": 15,
  "overall_retry_limit": 3,
  "timeout_seconds": 600,
  "env": {
    "DASHSCOPE_API_KEY": "$DASHSCOPE_API_KEY",
    "ACR_LITELLM_API_KEY": "$DASHSCOPE_API_KEY",
    "ACR_LITELLM_API_BASE": "https://dashscope.aliyuncs.com/compatible-mode/v1",
    "ACR_TOKEN_LIMIT": "16384",
    "ACR_LITELLM_TIMEOUT": "300",
    "ACR_LITELLM_EXTRA_BODY": "{\"enable_thinking\":false}"
  }
}
