{
  "model": "litellm-generic-openai/deepseek-ai/DeepSeek-V4-Pro",
  "prediction_model_name": "deepseek-v4-pro",
  "model_temperature": 0.0,
  "conv_round_limit": 15,
  "overall_retry_limit": 1,
  "timeout_seconds": 600,
  "env": {
    "ACR_LITELLM_API_KEY": "$SILICONFLOW_API_KEY",
    "ACR_LITELLM_API_BASE": "https://api.siliconflow.cn/v1",
    "ACR_TOKEN_LIMIT": "16384",
    "ACR_LITELLM_TIMEOUT": "300",
    "ACR_LITELLM_ENABLE_SEARCH_TOOLS": "0",
    "ACR_LITELLM_EXTRA_BODY": "{\"enable_thinking\":false}",
    "SILICONFLOW_API_KEY": "$SILICONFLOW_API_KEY"
  }
}
