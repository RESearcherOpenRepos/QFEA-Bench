{
  "model": "litellm-generic-openrouter/openai/gpt-5.5",
  "prediction_model_name": "gpt-5.5",
  "model_temperature": 0.0,
  "conv_round_limit": 5,
  "overall_retry_limit": 1,
  "timeout_seconds": 600,
  "env": {
    "OPENROUTER_API_KEY": "$OPENROUTER_API_KEY",
    "ACR_LITELLM_API_KEY": "$OPENROUTER_API_KEY",
    "ACR_LITELLM_API_BASE": "https://openrouter.ai/api/v1",
    "ACR_TOKEN_LIMIT": "16384",
    "ACR_LITELLM_TIMEOUT": "300",
    "ACR_LITELLM_EXTRA_BODY": "{\"usage\":{\"include\":true},\"reasoning\":{\"effort\":\"none\"}}"
  }
}
