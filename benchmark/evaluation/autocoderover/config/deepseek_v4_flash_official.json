{
  "model": "litellm-generic-openai/deepseek-v4-flash",
  "prediction_model_name": "deepseek-v4-flash",
  "model_temperature": 0.0,
  "conv_round_limit": 15,
  "overall_retry_limit": 3,
  "timeout_seconds": 600,
  "env": {
    "DEEPSEEK_API_KEY": "$DEEPSEEK_API_KEY",
    "OPENAI_API_KEY": "$DEEPSEEK_API_KEY",
