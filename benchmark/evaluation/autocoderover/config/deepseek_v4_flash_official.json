    "ACR_LITELLM_API_KEY": "$DEEPSEEK_API_KEY",
    "ACR_LITELLM_API_BASE": "https://api.deepseek.com",
    "ACR_TOKEN_LIMIT": "16384",
    "ACR_LITELLM_TIMEOUT": "300",
    "ACR_LITELLM_EXTRA_BODY": "{\"thinking\":{\"type\":\"disabled\"}}"
  }
}
