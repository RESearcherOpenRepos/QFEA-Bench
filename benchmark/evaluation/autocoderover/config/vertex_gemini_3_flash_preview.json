{
  "model": "litellm-generic-gemini/gemini-3-flash-preview",
  "prediction_model_name": "gemini-3-flash-preview",
  "model_temperature": 0.0,
  "conv_round_limit": 15,
  "overall_retry_limit": 3,
  "timeout_seconds": 600,
  "env": {
    "GoogleVertaxAI_API_KEY": "$GoogleVertaxAI_API_KEY",
    "GoogleProjectID": "$GoogleProjectID",
    "ACR_LITELLM_API_KEY": "$GoogleVertaxAI_API_KEY",
    "ACR_LITELLM_API_BASE": "https://aiplatform.googleapis.com/v1/projects/$GoogleProjectID/locations/global/publishers/google",
    "ACR_TOKEN_LIMIT": "16384",
    "ACR_LITELLM_TIMEOUT": "300",
    "ACR_LITELLM_EXTRA_BODY": "{\"generationConfig\":{\"thinkingConfig\":{\"thinkingLevel\":\"minimal\",\"includeThoughts\":false}}}"
  }
}
