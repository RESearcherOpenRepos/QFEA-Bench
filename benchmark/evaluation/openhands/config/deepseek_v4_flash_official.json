{
  "model": "openai/deepseek-v4-flash",
  "prediction_model_name": "deepseek-v4-flash",
  "api_key": "$DEEPSEEK_API_KEY",
  "base_url": "https://api.deepseek.com",
  "temperature": 0.0,
  "max_output_tokens": 16384,
  "litellm_extra_body": {
    "thinking": {
      "type": "disabled"
    }
  },
  "run": {
    "max_iterations": 100,
    "max_retries": 3
  },
  "tools": {
    "terminal": {
      "timeout_seconds": 120
    }
  }
}
