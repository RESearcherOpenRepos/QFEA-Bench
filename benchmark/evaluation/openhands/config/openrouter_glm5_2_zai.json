{
  "model": "openrouter/z-ai/glm-5.2",
  "prediction_model_name": "z-ai/glm-5.2",
  "api_key": "$OPENROUTER_API_KEY",
  "temperature": 0.0,
  "max_output_tokens": 16384,
  "reasoning_effort": "none",
  "enable_encrypted_reasoning": false,
  "litellm_extra_body": {
    "provider": {
      "only": [
        "Z.AI"
      ],
      "allow_fallbacks": false
    }
  },
  "run": {
    "max_iterations": 100,
    "max_retries": 3
  },
  "tools": {
    "terminal": {
      "timeout_seconds": 120
    }
  }
}
