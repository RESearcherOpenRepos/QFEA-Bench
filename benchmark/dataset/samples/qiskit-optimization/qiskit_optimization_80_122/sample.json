  "task": {
    "problem_statement": "QuadraticProgram had built-in methods for translating to and from DOcplex models, but users needed a reusable translator interface that could live outside the core problem class. The optimization package should provide DOcplex MP translator functions that convert supported models both into and out of QuadraticProgram while rejecting unsupported DOcplex constructs with the package's optimization error.",
    "requirements": [
      "Provide a qiskit_optimization.translators package that exposes DOcplex MP translator entry points.",
      "Convert a DOcplex MP model with binary, integer, and continuous variables into an equivalent QuadraticProgram.",
      "Convert QuadraticProgram objectives, linear constraints, and quadratic constraints to and from DOcplex MP while preserving names, bounds, senses, constants, linear terms, and quadratic terms.",
      "Reject unsupported DOcplex MP constructs such as semi-integer variables, range constraints, indicator constraints, equivalence constraints, and not-equal constraints with QiskitOptimizationError.",
      "Existing QuadraticProgram expression, constraint, objective, and variable behavior in the same directory must remain compatible."
    ],
    "interface": [
      {
        "Type": "Function",
        "Name": "from_docplex_mp",
        "Path": "qiskit_optimization/translators/docplex_mp.py",
        "Input": "model: docplex.mp.model.Model",
        "Output": "QuadraticProgram",
        "Description": "Translates a supported DOcplex MP model into an equivalent QuadraticProgram and raises QiskitOptimizationError for unsupported model elements."
      },
      {
        "Type": "Function",
        "Name": "to_docplex_mp",
        "Path": "qiskit_optimization/translators/docplex_mp.py",
        "Input": "quadratic_program: QuadraticProgram",
        "Output": "docplex.mp.model.Model",
        "Description": "Translates a QuadraticProgram into an equivalent DOcplex MP model."
      },
      {
        "Type": "Class",
        "Name": "QuadraticProgram",
        "Path": "qiskit_optimization/problems/quadratic_program.py",
        "Input": "constructor: name: str = ''",
        "Output": "",
        "Description": "Optimization problem container accepted by to_docplex_mp and returned by from_docplex_mp, preserving variables, objectives, and constraints in exported LP form."
      },
      {
        "Type": "Class",
        "Name": "QiskitOptimizationError",
        "Path": "qiskit_optimization/exceptions.py",
        "Input": "",
        "Output": "",
        "Description": "Error raised by from_docplex_mp for unsupported DOcplex MP model elements."
      }
    ]
  },
