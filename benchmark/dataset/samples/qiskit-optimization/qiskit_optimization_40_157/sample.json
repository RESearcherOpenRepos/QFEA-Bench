  "task": {
    "problem_statement": "Converting linear inequalities to QUBO currently goes through slack variables and equality penalties even for common binary-constraint patterns that can be represented directly as quadratic penalty terms. Users need a converter that recognizes those special linear inequality forms, removes the matching constraints, and adds the correct penalty terms to the objective while leaving non-matching constraints unchanged.",
    "requirements": [
      "Add a LinearInequalityToPenalty converter that is importable from qiskit_optimization.converters.",
      "For binary constraints of the form x <= y and x >= y, convert the inequality into the corresponding quadratic penalty without introducing slack variables.",
      "For binary constraints of the form sum(x_i) <= 1 and sum(x_i) >= n - 1, convert the inequality into pairwise quadratic penalty terms without introducing slack variables.",
      "Apply penalty terms with the correct sign for both minimization and maximization objectives, preserving existing objective constant, linear, and quadratic terms.",
      "Leave linear or quadratic constraints that do not match the supported special patterns in the converted problem.",
      "Automatically compute a penalty value from objective bounds when no penalty is supplied, and fall back to a default value when fractional constraint coefficients make automatic calculation unreliable.",
      "Expose a mutable penalty setting and remember the penalty value used during conversion.",
      "QuadraticProgramToQubo must include the new linear-inequality-to-penalty conversion in its default converter pipeline.",
      "Interpreting a converted solution must return the original variable vector and reject vectors with the wrong length using QiskitOptimizationError."
    ],
    "interface": [
      {
        "Type": "Class",
        "Name": "LinearInequalityToPenalty",
        "Path": "qiskit_optimization/converters/linear_inequality_to_penalty.py",
        "Input": "constructor: penalty: float | None = None",
        "Output": "",
        "Description": "QuadraticProgramConverter that converts supported binary linear inequality patterns into objective penalty terms."
      },
      {
        "Type": "Method",
        "Name": "LinearInequalityToPenalty.convert",
        "Path": "qiskit_optimization/converters/linear_inequality_to_penalty.py",
        "Input": "self, problem: QuadraticProgram",
        "Output": "QuadraticProgram",
        "Description": "Returns a converted problem with matching special linear inequalities removed and represented as objective penalty terms."
      },
      {
        "Type": "Method",
        "Name": "LinearInequalityToPenalty.interpret",
        "Path": "qiskit_optimization/converters/linear_inequality_to_penalty.py",
        "Input": "self, x",
        "Output": "numpy.ndarray",
        "Description": "Returns the original variable vector and raises QiskitOptimizationError when the vector length does not match the source problem."
      },
      {
        "Type": "Method",
        "Name": "LinearInequalityToPenalty.penalty",
        "Path": "qiskit_optimization/converters/linear_inequality_to_penalty.py",
        "Input": "get or set penalty: float | None",
        "Output": "float | None",
        "Description": "Gets or sets the penalty coefficient; setting None enables automatic penalty calculation on conversion."
      },
      {
        "Type": "Method",
        "Name": "LinearInequalityToPenalty._auto_define_penalty",
        "Path": "qiskit_optimization/converters/linear_inequality_to_penalty.py",
        "Input": "problem: QuadraticProgram",
        "Output": "float",
        "Description": "Computes the automatic penalty coefficient from objective bounds or returns the default fallback when fractional constraint coefficients are present."
      },
      {
        "Type": "Class",
        "Name": "QuadraticProgramToQubo",
        "Path": "qiskit_optimization/converters/quadratic_program_to_qubo.py",
        "Input": "constructor: penalty: float | None = None",
        "Output": "",
        "Description": "Default QUBO converter whose conversion pipeline includes LinearInequalityToPenalty."
      },
      {
        "Type": "Method",
