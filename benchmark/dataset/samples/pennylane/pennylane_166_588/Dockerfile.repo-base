# syntax=docker/dockerfile:1.7
ARG PYTHON_VERSION=3.9
FROM python:${PYTHON_VERSION}-slim-trixie

WORKDIR /workspace

ENV PYTHONDONTWRITEBYTECODE=1
ENV PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
ENV PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn
ENV REPO_DIR=/workspace/repo
ARG REPOSITORY_URL=https://github.com/PennyLaneAI/pennylane.git
ARG DEPENDENCY_COMMIT=d5986483da271a6de0a319c1b4e17c2f73d11402

RUN set -eux; \
    if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
        sed -i "s|http://deb.debian.org/debian|https://mirrors.tuna.tsinghua.edu.cn/debian|g; s|http://deb.debian.org/debian-security|https://mirrors.tuna.tsinghua.edu.cn/debian-security|g; s|https://deb.debian.org/debian|https://mirrors.tuna.tsinghua.edu.cn/debian|g; s|https://deb.debian.org/debian-security|https://mirrors.tuna.tsinghua.edu.cn/debian-security|g" /etc/apt/sources.list.d/debian.sources; \
    fi; \
    apt-get -o Acquire::Retries=5 update \
    && apt-get install -y --no-install-recommends build-essential git \
    && rm -rf /var/lib/apt/lists/*

RUN --mount=type=cache,id=quanbench-pip,target=/root/.cache/pip \
    for attempt in 1 2 3; do \
        git clone --filter=blob:none "${REPOSITORY_URL}" "${REPO_DIR}" && break; \
        if [ "$attempt" = "3" ]; then exit 1; fi; \
        rm -rf "${REPO_DIR}"; \
        sleep 3; \
    done \
    && cd "${REPO_DIR}" \
    && git fetch origin pull/588/head:refs/remotes/origin/pr-588 \
    && git checkout --force "${DEPENDENCY_COMMIT}" \
    && python -m pip install --upgrade "pip<25" "setuptools<70" wheel \
    && python -m pip install --upgrade \
        "numpy<1.24" "scipy<1.11" "networkx<3" "tensornetwork==0.3" autograd toml appdirs \
        "semantic_version==2.6" "dask[delayed]<2024" "autoray>=0.3.1,<0.7" \
        pytest==7.4.4 pytest-cov pytest-mock flaky \
    && python -m pip install --extra-index-url https://download.pytorch.org/whl/cpu "torch==2.2.2+cpu" \
    && python -m pip install -e . --no-deps
