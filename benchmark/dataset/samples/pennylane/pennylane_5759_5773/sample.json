  "task": {
    "problem_statement": "PennyLane can represent qubit observables and fermionic operators, while quantum chemistry users often need to exchange those objects with OpenFermion. The repository should provide a direct conversion path between PennyLane operator or fermionic representations and OpenFermion's qubit and fermion operator representations, including support for wire mappings and small imaginary numerical noise.",
    "requirements": [
      "PennyLane qubit operators made from sums, products, and linear combinations of Pauli words must be convertible to equivalent OpenFermion QubitOperator objects.",
      "PennyLane FermiWord and FermiSentence objects must be convertible to equivalent OpenFermion FermionOperator objects.",
      "OpenFermion QubitOperator objects must be convertible back into PennyLane qubit-operator containers with matching coefficients and wires, using the requested supported PennyLane output style when the lower-level qubit helper is called directly.",
      "OpenFermion FermionOperator objects must be convertible back into PennyLane fermionic representations.",
      "Explicit wire mappings must be honored in both conversion directions for qubit wires and fermionic orbital labels, and mappings that do not cover all required labels must be rejected.",
      "The conversion routines must drop imaginary coefficient parts only when they are below the requested tolerance and must preserve them when they exceed that tolerance.",
      "Unsupported top-level input objects, unsupported qubit output-style selectors, or non-Pauli PennyLane operators nested inside compound qubit expressions must raise clear ValueError exceptions instead of producing invalid or partial conversions."
    ],
    "interface": [
      {
        "Type": "Function",
        "Name": "from_openfermion",
        "Path": "pennylane/qchem/convert_openfermion.py",
        "Input": "openfermion operator, wires=None, tol=1e-16",
        "Output": "PennyLane LinearCombination, Sum, FermiWord, or FermiSentence",
        "Description": "Converts OpenFermion qubit and fermion operators into PennyLane representations while preserving coefficients, labels, and requested wire mappings."
      },
      {
        "Type": "Function",
        "Name": "_from_openfermion_qubit",
        "Path": "pennylane/qchem/convert_openfermion.py",
        "Input": "OpenFermion QubitOperator, wires=None, tol=1e-16, format='LinearCombination'",
        "Output": "PennyLane LinearCombination or Sum, according to the requested supported format",
        "Description": "Internal conversion helper for OpenFermion QubitOperator conversion. It should support the repository's qubit-container output styles and reject unsupported format selectors with ValueError."
      },
      {
        "Type": "Function",
        "Name": "to_openfermion",
        "Path": "pennylane/qchem/convert_openfermion.py",
        "Input": "PennyLane Sum, LinearCombination, FermiWord, or FermiSentence; wires=None; tol=1e-16",
        "Output": "OpenFermion QubitOperator or FermionOperator",
        "Description": "Converts PennyLane qubit and fermionic representations into OpenFermion operators. Wire mappings apply to qubit wires and fermionic orbital labels, and non-Pauli qubit components must be rejected before producing a partial OpenFermion operator."
      },
      {
        "Type": "Method",
        "Name": "FermiWord.to_string",
        "Path": "pennylane/fermi/fermionic.py",
        "Input": "self, wire_map=None",
        "Output": "str",
        "Description": "Returns the OpenFermion-compatible string form needed for fermionic conversion, applying wire_map to fermionic orbital labels when provided."
      }
    ]
  },
