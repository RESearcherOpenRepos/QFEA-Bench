  "task": {
    "problem_statement": "VQC currently requires users to provide one-hot encoded labels, which makes ordinary classification workflows inconvenient when labels are already represented as integers or categorical strings. Users should be able to train, score, and predict with VQC using plain class labels while preserving the original label representation in predictions.",
    "requirements": [
      "VQC must accept one-dimensional integer class labels without requiring callers to one-hot encode them first.",
      "VQC must accept categorical string labels and train them through the same classifier workflow.",
      "Predictions from VQC and NeuralNetworkClassifier must be decoded back to the original label representation when labels were encoded during fitting.",
      "Existing one-hot label validation and class-count behavior must continue to work for classifier workflows."
    ],
    "interface": [
      {
        "Type": "Class",
        "Name": "VQC",
        "Path": "qiskit_machine_learning/algorithms/classifiers/vqc.py",
        "Input": "constructor: num_qubits, feature_map, ansatz, loss, optimizer, quantum_instance, initial_point, callback",
        "Output": "VQC classifier instance",
        "Description": "Creates a variational quantum classifier that accepts one-hot labels, integer class labels, or categorical string labels for training."
      },
      {
        "Type": "Method",
        "Name": "VQC.fit",
        "Path": "qiskit_machine_learning/algorithms/classifiers/vqc.py",
        "Input": "X, y",
        "Output": "self",
        "Description": "Fits the classifier after validating and internally encoding integer or categorical labels as needed."
      },
      {
        "Type": "Method",
        "Name": "VQC.predict",
        "Path": "qiskit_machine_learning/algorithms/classifiers/vqc.py",
        "Input": "X",
        "Output": "predicted labels",
        "Description": "Returns predicted labels using the original label representation learned during fitting."
      },
      {
        "Type": "Method",
        "Name": "VQC.score",
        "Path": "qiskit_machine_learning/algorithms/classifiers/vqc.py",
        "Input": "X, y, sample_weight",
        "Output": "score",
        "Description": "Scores predictions against labels supplied in the same plain, categorical, or one-hot representation accepted by fitting."
      },
      {
        "Type": "Class",
        "Name": "NeuralNetworkClassifier",
        "Path": "qiskit_machine_learning/algorithms/classifiers/neural_network_classifier.py",
        "Input": "constructor: neural_network, loss, one_hot, optimizer, warm_start, initial_point, callback",
        "Output": "classifier instance",
        "Description": "Provides classifier label validation, encoding, fitting, prediction, and scoring for quantum neural network classifiers."
      },
