  "task": {
    "problem_statement": "Neural-network classifier and regressor training still contains places that process samples one at a time even though the neural network implementations can evaluate batches. Users need the underlying loss handling to preserve per-sample behavior for batched predictions and targets so training objectives can consume batches without collapsing them into a single scalar loss too early.",
    "requirements": [
      "For one-dimensional batched inputs, L1 and L2 loss evaluation must return one loss value per sample instead of collapsing the entire batch into one scalar.",
      "L1 and L2 loss gradients must preserve the input prediction shape and match the elementwise gradient of the corresponding loss.",
      "Existing neural-network classifier and regressor workflows using L1 and L2-style losses must continue to run after the batched loss behavior is added."
    ],
    "interface": [
      {
        "Type": "Class",
        "Name": "L1Loss",
        "Path": "qiskit_machine_learning/utils/loss_functions/loss_functions.py",
        "Input": "constructor:",
        "Output": "",
        "Description": "Provides L1 loss evaluation and gradients for one-dimensional batched arrays."
      },
      {
        "Type": "Method",
        "Name": "L1Loss.evaluate",
        "Path": "qiskit_machine_learning/utils/loss_functions/loss_functions.py",
        "Input": "predict, target",
        "Output": "ndarray or scalar",
        "Description": "Returns absolute-error losses with one value per sample for one-dimensional batched predictions."
      },
      {
        "Type": "Method",
        "Name": "L1Loss.gradient",
        "Path": "qiskit_machine_learning/utils/loss_functions/loss_functions.py",
        "Input": "predict, target",
        "Output": "ndarray or scalar",
        "Description": "Returns the elementwise L1 gradient with the same shape as the prediction input."
      },
      {
        "Type": "Class",
