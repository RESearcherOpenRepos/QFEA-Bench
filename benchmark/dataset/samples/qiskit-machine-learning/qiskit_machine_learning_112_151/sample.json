  "task": {
    "problem_statement": "Neural-network model training does not currently give users a supported way to observe intermediate optimization progress. Users need trainable neural-network classifier workflows to accept a callback during construction and invoke it while fitting so loss-related values and optimizer weights can be tracked during training.",
    "requirements": [
      "Neural-network classifiers must accept an optional callback when they are constructed.",
      "When a callback is supplied, classifier fitting must invoke it during optimization with the current objective weights and computed objective value.",
      "Callback objective values must be provided as floats.",
      "Callback weight values must match the neural network's trainable weight dimension and be provided as numeric values.",
      "Classifier training and scoring must continue to work for circuit-based and two-layer neural network classifiers across existing optimizer, loss, and simulator configurations.",
      "Classifier behavior must remain unchanged when no callback is supplied."
    ],
    "interface": [
      {
        "Type": "Class",
        "Name": "NeuralNetworkClassifier",
        "Path": "qiskit_machine_learning/algorithms/classifiers/neural_network_classifier.py",
        "Input": "constructor: neural_network, loss='squared_error', one_hot=False, optimizer=None, warm_start=False, initial_point=None, callback=None",
        "Output": "",
        "Description": "Classifier constructor accepts an optional callback used to observe objective weights and objective values during training."
      },
      {
        "Type": "Method",
        "Name": "NeuralNetworkClassifier.fit",
        "Path": "qiskit_machine_learning/algorithms/classifiers/neural_network_classifier.py",
        "Input": "X, y",
        "Output": "NeuralNetworkClassifier",
        "Description": "Fits the classifier and invokes the configured callback during objective evaluation when a callback is present."
      },
      {
        "Type": "Method",
        "Name": "NeuralNetworkClassifier.score",
        "Path": "qiskit_machine_learning/algorithms/classifiers/neural_network_classifier.py",
        "Input": "X, y, sample_weight=None",
        "Output": "float",
        "Description": "Scores fitted classifier workflows after training with or without a callback."
      },
      {
        "Type": "Class",
        "Name": "TrainableModel",
        "Path": "qiskit_machine_learning/algorithms/trainable_model.py",
        "Input": "constructor: neural_network, loss='squared_error', optimizer=None, warm_start=False, initial_point=None, callback=None",
        "Output": "",
        "Description": "Base trainable model stores the optional callback used by classifier training."
      },
