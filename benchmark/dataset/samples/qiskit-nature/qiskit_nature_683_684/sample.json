  "task": {
    "problem_statement": "BOPESSampler can sample potential energy surfaces with ground-state solvers, but it cannot consume excited-state solvers and return multiple energy curves for the same molecular geometry points. Users need BOPESSampler to work with excited-state solver workflows so they can sample ground and excited electronic-state energies across a potential energy surface.",
    "requirements": [
      "BOPESSampler must accept an excited-state solver in the same sampling workflow used for ground-state solvers.",
      "Sampling with an excited-state solver must evaluate each requested geometry point and return the sampled points unchanged.",
      "The sampled energies must preserve the multiple electronic-state energies produced by the excited-state solver for each geometry point.",
      "Existing BOPESSampler behavior for ground-state NumPyMinimumEigensolver workflows and Morse-potential fitting must remain compatible."
    ],
    "interface": [
      {
        "Type": "Class",
        "Name": "BOPESSampler",
        "Path": "qiskit_nature/algorithms/pes_samplers/bopes_sampler.py",
        "Input": "constructor: solver, bootstrap=False, num_bootstrap=None, extrapolator=None",
        "Output": "",
        "Description": "Configures potential-energy-surface sampling with either ground-state or excited-state solver workflows."
      },
      {
        "Type": "Method",
        "Name": "BOPESSampler.sample",
        "Path": "qiskit_nature/algorithms/pes_samplers/bopes_sampler.py",
        "Input": "problem, points, aux_operators=None",
        "Output": "BOPESSamplerResult",
        "Description": "Samples the configured solver at each geometry point and returns points, energies, and raw solver results."
      },
      {
        "Type": "Class",
        "Name": "BOPESSamplerResult",
        "Path": "qiskit_nature/results/bopes_sampler_result.py",
        "Input": "",
        "Output": "",
        "Description": "Stores sampled geometry points and scalar or multi-state energy values from BOPESSampler."
      }
    ]
