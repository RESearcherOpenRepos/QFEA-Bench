        "Path": "qiskit_nature/operators/second_quantization/quadratic_hamiltonian.py",
        "Input": "self",
        "Output": "tuple[numpy.ndarray, float]",
        "Description": "Returns the real antisymmetric Majorana matrix and its associated constant term."
      },
      {
        "Type": "Method",
        "Name": "QuadraticHamiltonian.diagonalizing_bogoliubov_transform",
        "Path": "qiskit_nature/operators/second_quantization/quadratic_hamiltonian.py",
        "Input": "self",
        "Output": "tuple[numpy.ndarray, numpy.ndarray, float]",
        "Description": "Returns the transformation that diagonalizes the quadratic Hamiltonian, the sorted orbital energies, and the transformed constant."
      }
    ]
