        "Input": "self",
        "Output": "int",
        "Description": "Returns the number of fermionic modes represented by the Hamiltonian."
      },
      {
        "Type": "Method",
        "Name": "QuadraticHamiltonian.conserves_particle_number",
        "Path": "qiskit_nature/operators/second_quantization/quadratic_hamiltonian.py",
        "Input": "self",
        "Output": "bool",
        "Description": "Reports whether the antisymmetric block is zero and particle number is conserved."
      },
      {
        "Type": "Method",
        "Name": "QuadraticHamiltonian.to_fermionic_op",
        "Path": "qiskit_nature/operators/second_quantization/quadratic_hamiltonian.py",
