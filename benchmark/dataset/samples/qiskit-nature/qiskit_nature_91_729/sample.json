  "task": {
    "problem_statement": "The SUCCD ansatz can build the standard singlet-paired double-excitation pool, but it cannot reproduce the legacy succ_full-style mirrored excitation grouping. Users who need that mirrored pool have no supported way to request it through SUCCD. The repository should add a mirror setting so SUCCD can generate the mirrored singlet-double excitation structure while keeping the existing non-mirrored behavior unchanged.",
    "requirements": [
      "SUCCD must accept a mirror setting that enables the legacy succ_full-style mirrored singlet-double excitation pool.",
      "When mirror is enabled, SUCCD must group symmetrically mirrored double excitations under shared parameters instead of generating only the default non-mirrored pool.",
      "The mirrored SUCCD excitation generation must work for the standard singlet-paired configuration, for generalized excitations, and when optional single excitations are included.",
      "Existing SUCCD behavior without mirror enabled must remain compatible, including standard excitation generation, generalized excitation generation, optional singles handling, and non-singlet validation."
    ],
    "interface": [
      {
        "Type": "Class",
        "Name": "SUCCD",
        "Path": "qiskit_nature/second_q/circuit/library/ansatzes/succd.py",
        "Input": "constructor: qubit_converter=None, num_particles=None, num_spin_orbitals=None, reps=1, initial_state=None, include_singles=(False, False), generalized=False, mirror=False",
        "Output": "",
        "Description": "Constructs the singlet-paired UCCD ansatz and must expose a mirror option for the mirrored excitation pool."
      },
      {
        "Type": "Method",
        "Name": "SUCCD.mirror",
        "Path": "qiskit_nature/second_q/circuit/library/ansatzes/succd.py",
        "Input": "self",
        "Output": "bool",
        "Description": "Reports whether symmetrically mirrored double excitations are enabled for the ansatz."
      },
      {
        "Type": "Method",
        "Name": "SUCCD.generate_excitations",
        "Path": "qiskit_nature/second_q/circuit/library/ansatzes/succd.py",
        "Input": "self, num_spin_orbitals, num_particles",
        "Output": "list[tuple[tuple[int, ...], tuple[int, ...]]]",
        "Description": "Generates the SUCCD excitation list, including the mirrored singlet-double pool when mirror is enabled."
      },
      {
        "Type": "Method",
        "Name": "SUCCD._build_fermionic_excitation_ops",
        "Path": "qiskit_nature/second_q/circuit/library/ansatzes/succd.py",
        "Input": "self, excitations",
        "Output": "list[FermionicOp]",
        "Description": "Builds fermionic excitation operators and must combine mirrored excitations so they share parameters when mirror is enabled."
      }
    ]
