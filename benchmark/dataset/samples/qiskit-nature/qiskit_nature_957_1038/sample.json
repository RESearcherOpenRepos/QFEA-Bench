  "task": {
    "problem_statement": "The second-quantized lattice Hamiltonians module includes common lattice classes but does not provide a Kagome lattice. Users need a dedicated KagomeLattice class that follows the existing lattice API and supports open, periodic, and mixed boundary conditions.",
    "requirements": [
      "A dedicated KagomeLattice must be available through the public second-quantized lattice API.",
      "The lattice must create a two-dimensional Kagome graph with three sites per unit cell for the requested row and column dimensions.",
      "Node count, node indexes, and weighted edge lists must follow the existing Lattice semantics.",
      "The lattice must support open, fully periodic, x-periodic, and y-periodic boundary conditions using the existing BoundaryCondition API.",
      "Bulk edges, boundary edges, and onsite self-loops must be represented with the configured weights.",
      "The weighted adjacency matrix must follow the existing Hermitian edge-weight convention, including conjugate entries for reverse directions."
    ],
    "interface": [
      {
        "Type": "Class",
        "Name": "KagomeLattice",
        "Path": "qiskit_nature/second_q/hamiltonians/lattices/kagome_lattice.py",
        "Input": "constructor: rows: int, cols: int, edge_parameter: complex = 1.0, onsite_parameter: complex = 0.0, boundary_condition: BoundaryCondition | tuple[BoundaryCondition, BoundaryCondition] = BoundaryCondition.OPEN",
        "Output": "",
        "Description": "Lattice class representing a Kagome lattice graph with configurable weights and boundary conditions, exposing graph, num_nodes, node_indexes, weighted_edge_list, and boundary-aware Hermitian edge weights."
      },
      {
        "Type": "Method",
        "Name": "KagomeLattice.to_adjacency_matrix",
        "Path": "qiskit_nature/second_q/hamiltonians/lattices/lattice.py",
        "Input": "self, weighted: bool = False",
        "Output": "adjacency matrix",
        "Description": "Returns the Kagome lattice adjacency matrix using the existing Hermitian weighted-edge convention."
      }
    ]
