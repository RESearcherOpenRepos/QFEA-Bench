  "task": {
    "problem_statement": "Qiskit Nature needs a modular electronic driver-result representation so that electronic integrals can be grouped into reusable property objects instead of being handled only as ad hoc raw arrays. Users should be able to organize one-body and two-body electronic integrals inside an IntegralProperty, query them by basis and body rank, transform their basis consistently, and generate the corresponding second-quantized operator.",
    "requirements": [
      "Provide a reusable IntegralProperty abstraction for electronic integrals in Qiskit Nature's property framework.",
      "IntegralProperty must store electronic integrals grouped by electronic basis and number of body terms.",
      "IntegralProperty must allow querying stored integrals by basis and body rank and return None when a requested entry is unavailable.",
      "Applying an electronic basis transform to IntegralProperty must update or extend the stored integrals consistently for the transformed basis.",
      "IntegralProperty.second_q_ops() must build the expected fermionic operator from the stored electronic integrals."
    ],
    "interface": [
      {
        "Type": "Class",
        "Name": "IntegralProperty",
        "Path": "qiskit_nature/properties/second_quantization/electronic/integrals/integral_property.py",
        "Input": "constructor: name, electronic_integrals, shift=None",
        "Output": "",
        "Description": "Groups electronic integrals into a reusable electronic property that can be transformed and converted into second-quantized operators."
      },
      {
        "Type": "Method",
        "Name": "IntegralProperty.add_electronic_integral",
        "Path": "qiskit_nature/properties/second_quantization/electronic/integrals/integral_property.py",
        "Input": "self, integral",
        "Output": "None",
        "Description": "Adds an electronic-integral object into the property's internal storage keyed by basis and body rank."
      },
      {
        "Type": "Method",
        "Name": "IntegralProperty.get_electronic_integral",
        "Path": "qiskit_nature/properties/second_quantization/electronic/integrals/integral_property.py",
        "Input": "self, basis, num_body_terms",
        "Output": "Optional[ElectronicIntegrals]",
        "Description": "Returns the stored electronic integrals for a requested basis and body rank when available."
      },
      {
        "Type": "Method",
        "Name": "IntegralProperty.transform_basis",
        "Path": "qiskit_nature/properties/second_quantization/electronic/integrals/integral_property.py",
        "Input": "self, transform",
        "Output": "None",
        "Description": "Transforms the stored electronic integrals into the target electronic basis and keeps them accessible through the property."
      },
      {
        "Type": "Method",
        "Name": "IntegralProperty.second_q_ops",
        "Path": "qiskit_nature/properties/second_quantization/electronic/integrals/integral_property.py",
        "Input": "self",
        "Output": "List[FermionicOp]",
        "Description": "Builds the second-quantized operator represented by the currently stored electronic integrals."
      }
    ]
