        "Input": "self, total_num_electrons, total_num_spatial_orbitals, occupation_alpha=None, occupation_beta=None",
        "Output": "",
        "Description": "Prepares the active basis and density information needed before transforming an electronic Hamiltonian outside a problem instance."
      },
