  "task": {
    "problem_statement": "SparseLabelOp instances do not currently have the commutator helper routines that users may know from Qiskit opflow. Users need second-quantized operators to support direct commutator, anti-commutator, and symmetric double-commutator utilities, with results simplified consistently and a way to identify zero sparse-label operators.",
    "requirements": [
      "The second_q operator package must provide commutator, anti-commutator, and double_commutator utilities for SparseLabelOp-compatible operands.",
      "The commutator utility must compute AB - BA and return a simplified SparseLabelOp result.",
      "The anti_commutator utility must compute AB + BA and return a simplified SparseLabelOp result.",
      "The double_commutator utility must compute the symmetric double-commutator expression for three operands and support both sign conventions.",
      "SparseLabelOp instances must expose an is_zero check that treats empty operators and coefficients within a tolerance as zero.",
      "Existing second-quantized operator behavior in the same operators package must remain compatible."
    ],
    "interface": [
      {
        "Type": "Function",
        "Name": "commutator",
        "Path": "qiskit_nature/second_q/operators/commutators.py",
        "Input": "op_a, op_b",
        "Output": "SparseLabelOp",
        "Description": "Computes AB - BA for two SparseLabelOp-compatible operands and returns the simplified result."
      },
      {
        "Type": "Function",
        "Name": "anti_commutator",
        "Path": "qiskit_nature/second_q/operators/commutators.py",
        "Input": "op_a, op_b",
        "Output": "SparseLabelOp",
        "Description": "Computes AB + BA for two SparseLabelOp-compatible operands and returns the simplified result."
      },
      {
        "Type": "Function",
        "Name": "double_commutator",
        "Path": "qiskit_nature/second_q/operators/commutators.py",
        "Input": "op_a, op_b, op_c, sign=False",
        "Output": "SparseLabelOp",
        "Description": "Computes the symmetric double-commutator expression for three SparseLabelOp-compatible operands and returns the simplified result."
      },
      {
        "Type": "Method",
        "Name": "SparseLabelOp.is_zero",
        "Path": "qiskit_nature/second_q/operators/sparse_label_op.py",
        "Input": "self, tol=None",
        "Output": "bool",
        "Description": "Returns whether the operator is empty or all stored coefficients are zero within the given tolerance, using the operator tolerance when no explicit tolerance is supplied."
      }
    ]
  },
