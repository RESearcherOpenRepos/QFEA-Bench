  "task": {
    "problem_statement": "The second-quantized mapper stack provides mapper implementations using the repository's default spin-orbital ordering, but it does not provide a wrapper for interleaved spin ordering. Users need a mapper that can reuse an existing QubitMapper while reordering fermionic operators into interleaved alpha/beta spin-orbital order before mapping.",
    "requirements": [
      "An InterleavedQubitMapper must be available through the public second-quantized mapper API.",
      "The mapper must wrap an existing QubitMapper and delegate the final qubit mapping to that wrapped mapper.",
      "Before delegation, it must reorder FermionicOp mode indices from blocked spin ordering into interleaved spin ordering.",
      "The resulting mapped qubit operator must match the wrapped mapper's output for the interleaved operator."
    ],
    "interface": [
      {
        "Type": "Class",
        "Name": "InterleavedQubitMapper",
        "Path": "qiskit_nature/second_q/mappers/interleaved_qubit_mapper.py",
        "Input": "constructor: mapper: QubitMapper",
        "Output": "",
        "Description": "Mapper wrapper that stores an underlying QubitMapper and maps fermionic operators after converting their mode ordering to interleaved spin order."
      },
      {
        "Type": "Method",
        "Name": "InterleavedQubitMapper.map",
        "Path": "qiskit_nature/second_q/mappers/qubit_mapper.py",
        "Input": "self, second_q_ops, register_length=None",
        "Output": "PauliSumOp or mapped collection",
        "Description": "Maps fermionic operators through the interleaved-order wrapper and returns the wrapped mapper's qubit-operator result."
      }
    ]
  },
