  },
  "task": {
    "problem_statement": "The second-quantized Hartree-Fock and VSCF initial-state circuits are built eagerly, so they cannot be instantiated first and configured later like other Qiskit blueprint circuits. Users need these initial states to support lazy construction and attribute-based configuration while preserving the same prepared states as the existing eager constructors.",
    "requirements": [
      "HartreeFock must behave as a BlueprintCircuit-compatible initial state that can be constructed without all configuration values and completed later through attributes.",
      "VSCF must behave as a BlueprintCircuit-compatible initial state that can be constructed without all configuration values and completed later through attributes.",
      "Setting HartreeFock configuration attributes must invalidate and rebuild the circuit so the final state matches the eager constructor for the same orbitals, particles, and qubit converter.",
      "Setting VSCF configuration attributes must invalidate and rebuild the circuit so the final state matches the eager constructor for the same modals and qubit converter.",
      "HartreeFock must report an unsupported Bravyi-Kitaev Super Fast mapper through NotImplementedError when the circuit is built.",
      "Existing Hartree-Fock and VSCF bitstring helper behavior must remain compatible with the prepared-state circuits."
    ],
    "interface": [
      {
        "Type": "Class",
        "Name": "HartreeFock",
        "Path": "qiskit_nature/second_q/circuit/library/initial_states/hartree_fock.py",
        "Input": "constructor: num_spatial_orbitals=None, num_particles=None, qubit_converter=None",
        "Output": "",
        "Description": "Blueprint-compatible initial-state circuit whose num_spatial_orbitals, num_particles, and qubit_converter configuration can be supplied at construction time or later through attributes."
      },
      {
        "Type": "Class",
        "Name": "VSCF",
        "Path": "qiskit_nature/second_q/circuit/library/initial_states/vscf.py",
        "Input": "constructor: num_modals=None, qubit_converter=None",
        "Output": "",
        "Description": "Blueprint-compatible vibrational initial-state circuit whose num_modals and qubit_converter configuration can be supplied at construction time or later through attributes."
      },
      {
        "Type": "Function",
        "Name": "hartree_fock_bitstring",
        "Path": "qiskit_nature/second_q/circuit/library/initial_states/hartree_fock.py",
        "Input": "num_spatial_orbitals, num_particles",
        "Output": "list[bool]",
        "Description": "Returns the Hartree-Fock occupation bitstring for the requested spatial orbitals and particles."
      },
      {
        "Type": "Function",
        "Name": "hartree_fock_bitstring_mapped",
        "Path": "qiskit_nature/second_q/circuit/library/initial_states/hartree_fock.py",
        "Input": "num_spatial_orbitals, num_particles, qubit_converter, match_convert=True",
        "Output": "list[bool]",
        "Description": "Returns the mapped Hartree-Fock occupation bitstring using the supplied qubit converter."
      },
      {
        "Type": "Function",
        "Name": "vscf_bitstring",
