        "Type": "Method",
        "Name": "HexagonalLattice.to_adjacency_matrix",
        "Path": "qiskit_nature/second_q/hamiltonians/lattices/lattice.py",
        "Input": "self, weighted: bool = False",
        "Output": "adjacency matrix",
        "Description": "Returns the hexagonal lattice adjacency matrix using the existing Hermitian weighted-edge convention."
      }
