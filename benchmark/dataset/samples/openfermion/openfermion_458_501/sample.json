  "task": {
    "problem_statement": "OpenFermion needs a native Majorana-operator representation so users can express fermionic models directly in the Majorana basis instead of encoding these products indirectly through other operator classes. The implementation should provide a MajoranaOperator type with the expected canonical term normalization, algebraic operations, string formatting, and public package export.",
    "requirements": [
      "Provide a MajoranaOperator class that canonicalizes Majorana terms by sorting indices, removing repeated pairs, and applying the corresponding parity sign change.",
      "Allow MajoranaOperator instances to test commutation, add, subtract, multiply, divide by scalars, and format themselves in a canonical Majorana representation, including empty products as `()` and the zero operator as `0`.",
      "Allow scalar and operator multiplication to combine Majorana terms with the correct coefficient updates and merged-term parity.",
      "Expose MajoranaOperator through the public openfermion package import path."
    ],
    "interface": [
      {
        "Type": "Class",
        "Name": "MajoranaOperator",
        "Path": "src/openfermion/ops/_majorana_operator.py",
        "Input": "constructor: term=None, coefficient=1.0",
        "Output": "",
        "Description": "Represents linear combinations of Majorana-operator products and normalizes single-term inputs into canonical order."
      },
      {
        "Type": "Method",
        "Name": "commutes_with",
        "Path": "src/openfermion/ops/_majorana_operator.py",
        "Input": "self, other",
        "Output": "bool",
        "Description": "Tests commutation against another MajoranaOperator and rejects unsupported operand types."
      },
      {
        "Type": "Method",
        "Name": "__mul__",
        "Path": "src/openfermion/ops/_majorana_operator.py",
        "Input": "self, other",
        "Output": "MajoranaOperator",
        "Description": "Supports multiplication by another MajoranaOperator or by numeric scalars using Majorana-term merge rules."
      },
      {
        "Type": "Method",
        "Name": "__truediv__",
        "Path": "src/openfermion/ops/_majorana_operator.py",
        "Input": "self, other",
        "Output": "MajoranaOperator",
        "Description": "Supports division of a MajoranaOperator by numeric scalars."
      },
      {
        "Type": "Method",
        "Name": "__str__",
        "Path": "src/openfermion/ops/_majorana_operator.py",
        "Input": "self",
        "Output": "str",
        "Description": "Formats MajoranaOperator terms in the canonical human-readable representation: coefficients followed by parenthesized Majorana index tuples, with the identity or empty product rendered as `()` and the zero operator rendered as `0`."
      }
    ]
  },
