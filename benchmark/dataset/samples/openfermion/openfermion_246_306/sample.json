  "task": {
    "problem_statement": "OpenFermion needs a specialized Hamiltonian representation for electronic-structure models with a diagonal Coulomb term so that these operators can be stored more compactly and transformed more directly than a generic FermionOperator. Users need a DiagonalCoulombHamiltonian representation together with conversion routines back to FermionOperator form, support for Jordan-Wigner mapping, sparse-operator conversion, and the same qubit-count and validity checks expected by the surrounding transform utilities.",
    "requirements": [
      "Provide a DiagonalCoulombHamiltonian representation for Hamiltonians with Hermitian one-body terms, real symmetric diagonal Coulomb terms, and an optional constant term.",
      "Allow valid diagonal-Coulomb FermionOperator instances to be converted into DiagonalCoulombHamiltonian form and converted back without changing the represented Hamiltonian.",
      "Reject non-FermionOperator inputs with TypeError, and raise ValueError for non-diagonal or unsupported FermionOperator terms, non-real diagonal-Coulomb coefficients, or too-small requested qubit counts.",
      "Allow jordan_wigner to accept a DiagonalCoulombHamiltonian and produce the same QubitOperator as applying Jordan-Wigner to the equivalent FermionOperator for supported diagonal-Coulomb inputs.",
      "Allow get_sparse_operator to accept a DiagonalCoulombHamiltonian and return the same sparse operator as the Jordan-Wigner image of the equivalent FermionOperator.",
      "Keep the existing FermionOperator, InteractionOperator, QuadraticHamiltonian, and QubitOperator conversion behavior working."
    ],
    "interface": [
      {
        "Type": "Class",
        "Name": "DiagonalCoulombHamiltonian",
        "Path": "src/openfermion/ops/_diagonal_coulomb_hamiltonian.py",
        "Input": "constructor: one_body, two_body, constant=0.",
        "Output": "",
        "Description": "Stores Hamiltonians with a Hermitian one-body matrix, a real symmetric diagonal Coulomb matrix, and a constant term."
      },
      {
        "Type": "Function",
        "Name": "get_diagonal_coulomb_hamiltonian",
        "Path": "src/openfermion/transforms/_conversion.py",
        "Input": "fermion_operator: FermionOperator, n_qubits=None",
        "Output": "DiagonalCoulombHamiltonian",
        "Description": "Converts a valid diagonal-Coulomb FermionOperator into DiagonalCoulombHamiltonian form, rejecting non-FermionOperator inputs with TypeError and invalid representation or qubit-count cases with ValueError."
      },
      {
        "Type": "Function",
        "Name": "get_fermion_operator",
        "Path": "src/openfermion/transforms/_conversion.py",
        "Input": "operator: PolynomialTensor | DiagonalCoulombHamiltonian",
        "Output": "FermionOperator",
        "Description": "Converts supported structured operator representations into FermionOperator form."
      },
      {
        "Type": "Function",
        "Name": "jordan_wigner",
        "Path": "src/openfermion/transforms/_jordan_wigner.py",
        "Input": "operator: FermionOperator | InteractionOperator | DiagonalCoulombHamiltonian",
        "Output": "QubitOperator",
        "Description": "Maps supported fermionic operator representations into the Jordan-Wigner qubit representation."
      },
      {
        "Type": "Function",
        "Name": "get_sparse_operator",
        "Path": "src/openfermion/transforms/_conversion.py",
        "Input": "operator, n_qubits=None",
        "Output": "scipy.sparse matrix",
        "Description": "Converts supported operators into sparse-matrix form, using the Jordan-Wigner image for non-QubitOperator inputs."
      }
    ]
  },
