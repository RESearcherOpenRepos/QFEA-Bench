        "pull_request": {
          "url": "https://api.github.com/repos/Qiskit/qiskit-addon-sqd/pulls/251",
          "html_url": "https://github.com/Qiskit/qiskit-addon-sqd/pull/251",
          "diff_url": "https://github.com/Qiskit/qiskit-addon-sqd/pull/251.diff",
