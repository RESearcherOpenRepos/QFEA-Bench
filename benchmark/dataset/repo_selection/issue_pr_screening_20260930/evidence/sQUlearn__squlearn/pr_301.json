  "issue_url": "https://api.github.com/repos/sQUlearn/squlearn/issues/301",
  "number": 301,
  "state": "closed",
  "locked": false,
  "title": "Remove need for `num_features` before fitting ",
  "user": {
    "login": "DennisKleinhans",
    "id": 44137912,
    "node_id": "MDQ6VXNlcjQ0MTM3OTEy",
    "avatar_url": "https://avatars.githubusercontent.com/u/44137912?v=4",
    "gravatar_id": "",
    "url": "https://api.github.com/users/DennisKleinhans",
    "html_url": "https://github.com/DennisKleinhans",
    "followers_url": "https://api.github.com/users/DennisKleinhans/followers",
    "following_url": "https://api.github.com/users/DennisKleinhans/following{/other_user}",
    "gists_url": "https://api.github.com/users/DennisKleinhans/gists{/gist_id}",
    "starred_url": "https://api.github.com/users/DennisKleinhans/starred{/owner}{/repo}",
    "subscriptions_url": "https://api.github.com/users/DennisKleinhans/subscriptions",
    "organizations_url": "https://api.github.com/users/DennisKleinhans/orgs",
    "repos_url": "https://api.github.com/users/DennisKleinhans/repos",
    "events_url": "https://api.github.com/users/DennisKleinhans/events{/privacy}",
    "received_events_url": "https://api.github.com/users/DennisKleinhans/received_events",
    "type": "User",
