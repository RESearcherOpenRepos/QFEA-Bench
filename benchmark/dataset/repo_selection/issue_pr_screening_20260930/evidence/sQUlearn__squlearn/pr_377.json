  "title": "Make Executor session handling safer",
  "user": {
    "login": "MoritzWillmann",
    "id": 44642314,
    "node_id": "MDQ6VXNlcjQ0NjQyMzE0",
    "avatar_url": "https://avatars.githubusercontent.com/u/44642314?v=4",
    "gravatar_id": "",
