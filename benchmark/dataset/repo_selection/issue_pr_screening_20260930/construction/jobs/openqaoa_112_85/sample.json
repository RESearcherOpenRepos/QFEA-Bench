    "problem_statement": "OpenQAOA users need to supply custom mixer circuits as rotation-gate maps rather than being limited to a mixer Hamiltonian. Both representations should describe consistent QAOA layers and coefficient assignments.",
    "requirements": [
      "Accept a Hamiltonian or a list of rotation-gate maps as the mixer block.",
      "Associate user-supplied mixer coefficients with gate maps and reject a mismatched number of coefficients.",
      "Preserve the separation and ordering of single-qubit and two-qubit mixer terms across QAOA layers.",
      "Produce equivalent circuit-parameter attributes for equivalent Hamiltonian and gate-map mixer inputs."
    ],
    "interface": [
      {
        "Type": "Class",
        "Name": "QAOACircuitParams",
        "Path": "openqaoa/qaoa_parameters/baseparams.py",
        "Input": "constructor: cost_hamiltonian, mixer_block, p, mixer_coeffs=[]",
        "Output": "",
        "Description": "Provides QAOA layer blocks, mixer coefficients, and single/pair coefficient and gate-name attributes."
