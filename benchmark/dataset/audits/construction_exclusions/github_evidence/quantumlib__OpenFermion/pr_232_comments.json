      "starred_url": "https://api.github.com/users/kanavsetia/starred{/owner}{/repo}",
      "subscriptions_url": "https://api.github.com/users/kanavsetia/subscriptions",
      "organizations_url": "https://api.github.com/users/kanavsetia/orgs",
      "repos_url": "https://api.github.com/users/kanavsetia/repos",
      "events_url": "https://api.github.com/users/kanavsetia/events{/privacy}",
      "received_events_url": "https://api.github.com/users/kanavsetia/received_events",
      "type": "User",
